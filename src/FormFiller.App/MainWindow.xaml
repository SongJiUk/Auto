<Window x:Class="FormFiller.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FormFiller.App.ViewModels"
        Title="서식 채우기" Height="820" Width="860"
        MinHeight="600" MinWidth="680"
        FontFamily="Malgun Gothic" FontSize="13">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <Style TargetType="GroupBox">
            <Setter Property="Margin"      Value="0,0,0,10"/>
            <Setter Property="Padding"     Value="8,6"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="Foreground"  Value="#2D3748"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
        </Style>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground"        Value="#4A5568"/>
            <Setter Property="Margin"            Value="0,0,6,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding"         Value="4,3"/>
            <Setter Property="BorderBrush"     Value="#CBD5E0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <!-- 읽기 전용 셀 (회색) -->
        <Style x:Key="ROCell" TargetType="TextBlock">
            <Setter Property="Background"        Value="#F7FAFC"/>
            <Setter Property="Foreground"        Value="#718096"/>
            <Setter Property="TextAlignment"     Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding"           Value="4,0"/>
        </Style>
        <!-- 편집 가능 셀 -->
        <Style x:Key="EditCell" TargetType="TextBox">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Padding"       Value="4,2"/>
            <Setter Property="BorderBrush"   Value="#4299E1"/>
        </Style>
        <!-- 삭제 버튼 (DataGrid 행) -->
        <Style x:Key="DelBtn" TargetType="Button">
            <Setter Property="Background"    Value="#FED7D7"/>
            <Setter Property="Foreground"    Value="#C53030"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width"         Value="22"/>
            <Setter Property="Height"        Value="22"/>
            <Setter Property="FontSize"      Value="12"/>
            <Setter Property="Cursor"        Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FC8181"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 추가 버튼 -->
        <Style x:Key="AddBtn" TargetType="Button">
            <Setter Property="Background"    Value="#EBF8FF"/>
            <Setter Property="Foreground"    Value="#2B6CB0"/>
            <Setter Property="BorderBrush"   Value="#BEE3F8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"       Value="8,3"/>
            <Setter Property="Cursor"        Value="Hand"/>
            <Setter Property="FontSize"      Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#BEE3F8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ─── 헤더 ─────────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="#2B6CB0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="서식 채우기" Foreground="White"
                               FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Foreground="#BEE3F8" FontSize="12" Margin="12,0,0,0"
                               VerticalAlignment="Center" Text="공사일보 · 출력일보 · TBM일지"/>
                </StackPanel>

                <!-- AI 도우미 버튼 -->
                <Button Grid.Column="1"
                        Content="🤖 AI 도우미"
                        Command="{Binding OpenAiAssistantCommand}"
                        Margin="0,0,8,0"
                        Background="Transparent" Foreground="White"
                        BorderThickness="1" BorderBrush="#BEE3F8"
                        Padding="8,2" Cursor="Hand"
                        VerticalAlignment="Center">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background"  Value="Transparent"/>
                            <Setter Property="Foreground"  Value="White"/>
                            <Setter Property="BorderBrush" Value="#BEE3F8"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Cursor"      Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="3" Padding="8,2">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#2C5282"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- 설정 버튼 -->
                <Button Grid.Column="2"
                        Content="⚙ 설정"
                        Click="OpenSettings_Click"
                        Background="Transparent" Foreground="White"
                        BorderThickness="1" BorderBrush="#BEE3F8"
                        Padding="8,2" Cursor="Hand"
                        VerticalAlignment="Center">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background"  Value="Transparent"/>
                            <Setter Property="Foreground"  Value="White"/>
                            <Setter Property="BorderBrush" Value="#BEE3F8"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Cursor"      Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="3" Padding="8,2">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#2C5282"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- ─── 본문 ─────────────────────────────────────────────── -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,8">
            <StackPanel>

                <!-- 기본 정보 -->
                <GroupBox Header="기본 정보">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="날짜" Style="{StaticResource LabelStyle}"/>
                        <DatePicker Grid.Column="1"
                                    SelectedDate="{Binding TargetDate, Mode=TwoWay}"
                                    FirstDayOfWeek="Monday"/>
                        <TextBlock Grid.Column="3" Text="날씨" Style="{StaticResource LabelStyle}"/>
                        <ComboBox Grid.Column="4"
                                  ItemsSource="{Binding WeatherOptions}"
                                  SelectedItem="{Binding Weather, Mode=TwoWay}"/>
                    </Grid>
                </GroupBox>

                <!-- ══════════════ 작업사항 ══════════════ -->
                <GroupBox Header="작업사항">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ── 금일 (오전/오후 탭) ── -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="금일 작업사항"
                                       Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                            <TabControl Grid.Row="1" BorderBrush="#CBD5E0">
                                <!-- 오전 탭 -->
                                <TabItem Header="오전">
                                    <StackPanel Margin="0,4,0,0">
                                        <ItemsControl ItemsSource="{Binding TodayMorningItems}" MinHeight="50">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Grid.Column="0"
                                                                 Text="{Binding Text, Mode=TwoWay,
                                                                        UpdateSourceTrigger=PropertyChanged}"
                                                                 Padding="4,3" BorderBrush="#CBD5E0"/>
                                                        <Button Grid.Column="1" Content="×"
                                                                Command="{Binding RemoveCommand}"
                                                                Style="{StaticResource DelBtn}"
                                                                Margin="4,0,0,0" ToolTip="삭제"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Button Content="+ 직접 추가"
                                                    Command="{Binding AddMorningWorkCommand}"
                                                    Style="{StaticResource AddBtn}"/>
                                            <Button Content="☰ 항목 선택"
                                                    Command="{Binding PickMorningWorkCommand}"
                                                    Style="{StaticResource AddBtn}"
                                                    Margin="6,0,0,0"
                                                    Background="#F0FFF4" Foreground="#276749"
                                                    BorderBrush="#9AE6B4"/>
                                        </StackPanel>
                                    </StackPanel>
                                </TabItem>
                                <!-- 오후 탭 -->
                                <TabItem Header="오후">
                                    <StackPanel Margin="0,4,0,0">
                                        <ItemsControl ItemsSource="{Binding TodayAfternoonItems}" MinHeight="50">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Grid.Column="0"
                                                                 Text="{Binding Text, Mode=TwoWay,
                                                                        UpdateSourceTrigger=PropertyChanged}"
                                                                 Padding="4,3" BorderBrush="#CBD5E0"/>
                                                        <Button Grid.Column="1" Content="×"
                                                                Command="{Binding RemoveCommand}"
                                                                Style="{StaticResource DelBtn}"
                                                                Margin="4,0,0,0" ToolTip="삭제"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Button Content="+ 직접 추가"
                                                    Command="{Binding AddAfternoonWorkCommand}"
                                                    Style="{StaticResource AddBtn}"/>
                                            <Button Content="☰ 항목 선택"
                                                    Command="{Binding PickAfternoonWorkCommand}"
                                                    Style="{StaticResource AddBtn}"
                                                    Margin="6,0,0,0"
                                                    Background="#F0FFF4" Foreground="#276749"
                                                    BorderBrush="#9AE6B4"/>
                                        </StackPanel>
                                    </StackPanel>
                                </TabItem>
                            </TabControl>
                        </Grid>

                        <!-- ── 명일 작업사항 ── -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="명일 작업사항"
                                       Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding TomorrowWorkItems}" MinHeight="60">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding Text, Mode=TwoWay,
                                                            UpdateSourceTrigger=PropertyChanged}"
                                                     Padding="4,3" BorderBrush="#CBD5E0"/>
                                            <Button Grid.Column="1" Content="×"
                                                    Command="{Binding RemoveCommand}"
                                                    Style="{StaticResource DelBtn}"
                                                    Margin="4,0,0,0" ToolTip="삭제"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,0">
                                <Button Content="+ 직접 추가"
                                        Command="{Binding AddTomorrowWorkCommand}"
                                        Style="{StaticResource AddBtn}"/>
                                <Button Content="☰ 항목 선택"
                                        Command="{Binding PickTomorrowWorkCommand}"
                                        Style="{StaticResource AddBtn}"
                                        Margin="6,0,0,0"
                                        Background="#F0FFF4" Foreground="#276749"
                                        BorderBrush="#9AE6B4"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </GroupBox>

                <!-- ══════════════ 장비 투입현황 ══════════════ -->
                <GroupBox Header="장비 투입현황">
                    <StackPanel>
                        <DataGrid ItemsSource="{Binding Equipment}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserResizeRows="False" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#EDF2F7"
                                  RowHeight="30" SelectionMode="Single"
                                  BorderBrush="#CBD5E0" BorderThickness="1">
                            <DataGrid.Columns>
                                <!-- 장비명: 편집 가능 -->
                                <DataGridTemplateColumn Header="장비명" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}"
                                                       VerticalAlignment="Center" Padding="4,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Name, Mode=TwoWay,
                                                             UpdateSourceTrigger=PropertyChanged}"
                                                     Padding="4,2"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <!-- 규격: 편집 가능 -->
                                <DataGridTemplateColumn Header="규격" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Spec}"
                                                       VerticalAlignment="Center" Padding="4,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Spec, Mode=TwoWay,
                                                             UpdateSourceTrigger=PropertyChanged}"
                                                     Padding="4,2"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <!-- 전일: 편집 가능 -->
                                <DataGridTemplateColumn Header="전일(대) ✏" Width="85">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding PrevDayCount}"
                                                       Style="{StaticResource ROCell}"
                                                       Foreground="#2D3748"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding PrevDayCount, Mode=TwoWay,
                                                             UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource EditCell}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <!-- 금일: 편집 가능 -->
                                <DataGridTemplateColumn Header="금일(대) ✏" Width="85">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TodayCount}"
                                                       TextAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding TodayCount, Mode=TwoWay,
                                                             UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource EditCell}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <!-- 누계: 자동 계산, 읽기 전용 -->
                                <DataGridTemplateColumn Header="누계(대)" Width="75">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TotalCount}"
                                                       Style="{StaticResource ROCell}"
                                                       FontWeight="SemiBold"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- 삭제 버튼 -->
                                <DataGridTemplateColumn Header="" Width="30">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="×"
                                                    Command="{Binding RemoveCommand}"
                                                    Style="{StaticResource DelBtn}"
                                                    ToolTip="행 삭제"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- 장비 추가 버튼 -->
                        <Button Content="+ 장비 추가"
                                Command="{Binding AddEquipmentCommand}"
                                HorizontalAlignment="Left" Margin="0,6,0,0"
                                Style="{StaticResource AddBtn}"/>
                    </StackPanel>
                </GroupBox>

                <!-- ══════════════ 인원 투입현황 ══════════════ -->
                <GroupBox Header="인원 투입현황">
                    <StackPanel>
                        <DataGrid ItemsSource="{Binding Personnel}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserResizeRows="False" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#EDF2F7"
                                  RowHeight="30" SelectionMode="Single"
                                  BorderBrush="#CBD5E0" BorderThickness="1">
                            <DataGrid.Columns>
                                <!-- 직종: 편집 가능 -->
                                <DataGridTemplateColumn Header="직종" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Role}"
                                                       VerticalAlignment="Center" Padding="4,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Role, Mode=TwoWay,
                                                             UpdateSourceTrigger=PropertyChanged}"
                                                     Padding="4,2"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <!-- 전일누계: 편집 가능 -->
                                <DataGridTemplateColumn Header="전일누계(명) ✏" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding PrevCumulativeCount}"
                                                       Style="{StaticResource ROCell}"
                                                       Foreground="#2D3748"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding PrevCumulativeCount, Mode=TwoWay,
                                                             UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource EditCell}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <!-- 금일: 편집 가능 -->
                                <DataGridTemplateColumn Header="금일(명) ✏" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TodayCount}"
                                                       TextAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding TodayCount, Mode=TwoWay,
                                                             UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource EditCell}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <!-- 총누계: 자동 계산 -->
                                <DataGridTemplateColumn Header="총누계(명)" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TotalCumulativeCount}"
                                                       Style="{StaticResource ROCell}"
                                                       FontWeight="SemiBold"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- 삭제 -->
                                <DataGridTemplateColumn Header="" Width="30">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="×"
                                                    Command="{Binding RemoveCommand}"
                                                    Style="{StaticResource DelBtn}"
                                                    ToolTip="행 삭제"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Button Content="+ 직종 추가"
                                Command="{Binding AddPersonnelCommand}"
                                HorizontalAlignment="Left" Margin="0,6,0,0"
                                Style="{StaticResource AddBtn}"/>
                    </StackPanel>
                </GroupBox>

                <!-- ══════════════ 수장재팀 ══════════════ -->
                <GroupBox Header="수장재팀 인원 (별도)">
                    <StackPanel>
                        <DataGrid ItemsSource="{Binding SujangjaePersonnel}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserResizeRows="False" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#EDF2F7"
                                  RowHeight="30" SelectionMode="Single"
                                  BorderBrush="#CBD5E0" BorderThickness="1">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="직종" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Role}"
                                                       VerticalAlignment="Center" Padding="4,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Role, Mode=TwoWay,
                                                             UpdateSourceTrigger=PropertyChanged}"
                                                     Padding="4,2"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="전일누계(명) ✏" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding PrevCumulativeCount}"
                                                       Style="{StaticResource ROCell}"
                                                       Foreground="#2D3748"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding PrevCumulativeCount, Mode=TwoWay,
                                                             UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource EditCell}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="금일(명) ✏" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TodayCount}"
                                                       TextAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding TodayCount, Mode=TwoWay,
                                                             UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource EditCell}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="총누계(명)" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TotalCumulativeCount}"
                                                       Style="{StaticResource ROCell}"
                                                       FontWeight="SemiBold"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="" Width="30">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="×"
                                                    Command="{Binding RemoveCommand}"
                                                    Style="{StaticResource DelBtn}"
                                                    ToolTip="행 삭제"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Button Content="+ 직종 추가"
                                Command="{Binding AddSujangjaeCommand}"
                                HorizontalAlignment="Left" Margin="0,6,0,0"
                                Style="{StaticResource AddBtn}"/>
                    </StackPanel>
                </GroupBox>

                <!-- ══════════════ 오늘 생성할 문서 ══════════════ -->
                <GroupBox Header="오늘 생성할 문서">
                    <ItemsControl ItemsSource="{Binding DocumentDueList}" Margin="4,2">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Name}"
                                               VerticalAlignment="Center" Foreground="#2D3748"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding FrequencyLabel}"
                                               Foreground="#718096" FontSize="11"
                                               VerticalAlignment="Center" Margin="8,0"/>
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding NextDueText}"
                                               Foreground="#E53E3E" FontSize="11"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </GroupBox>

                <!-- ══════════════ 사진대지 ══════════════ -->
                <GroupBox Header="📷 사진대지 사진"
                          Visibility="{Binding HasPhotoSlots,
                                       Converter={StaticResource BoolVis}}">
                    <StackPanel>
                        <TextBlock Foreground="#718096" FontSize="11" Margin="0,0,0,8"
                                   Text="이미지 파일을 슬롯에 드래그하거나 클릭해서 선택하세요."/>
                        <ItemsControl ItemsSource="{Binding PhotoSlots}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PhotoSlotViewModel}">
                                    <Border Width="160" Height="130"
                                            Margin="0,0,10,10"
                                            BorderBrush="#CBD5E0" BorderThickness="1"
                                            CornerRadius="4" Background="#F7FAFC"
                                            AllowDrop="True"
                                            Drop="PhotoSlot_Drop"
                                            DragOver="PhotoSlot_DragOver"
                                            Cursor="Hand">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#F7FAFC"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasPhoto}" Value="True">
                                                        <Setter Property="Background" Value="#EBF8FF"/>
                                                        <Setter Property="BorderBrush" Value="#4299E1"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Button Command="{Binding BrowseCommand}"
                                                    Background="Transparent" BorderThickness="0"
                                                    HorizontalContentAlignment="Stretch"
                                                    VerticalContentAlignment="Stretch" Padding="0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <ContentPresenter/>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <Grid>
                                                    <StackPanel VerticalAlignment="Center"
                                                                HorizontalAlignment="Center"
                                                                Visibility="{Binding PlaceholderVisible,
                                                                             Converter={StaticResource BoolVis}}">
                                                        <TextBlock Text="🖼" FontSize="28"
                                                                   HorizontalAlignment="Center"/>
                                                        <TextBlock Text="클릭 또는 드래그"
                                                                   Foreground="#A0AEC0" FontSize="11"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                    <Image Source="{Binding Thumbnail}"
                                                           Stretch="UniformToFill"
                                                           Width="160" Height="105"
                                                           VerticalAlignment="Top">
                                                        <Image.Style>
                                                            <Style TargetType="Image">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasPhoto}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Image.Style>
                                                    </Image>
                                                </Grid>
                                            </Button>
                                            <Grid VerticalAlignment="Bottom" Height="25"
                                                  Background="#00000018">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Label}"
                                                           Foreground="#2D3748" FontSize="11"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           Margin="6,0"/>
                                                <Button Grid.Column="1"
                                                        Command="{Binding ClearCommand}"
                                                        Content="✕" Width="22" Height="22"
                                                        FontSize="10"
                                                        Background="#FEB2B2" Foreground="#C53030"
                                                        BorderThickness="0" Margin="0,0,2,0"
                                                        VerticalAlignment="Center" Cursor="Hand">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="{TemplateBinding Background}"
                                                                                CornerRadius="11" Padding="2">
                                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                                              VerticalAlignment="Center"/>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasPhoto}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- ─── 하단 합계 + 생성 버튼 ───────────────────────────── -->
        <Border Grid.Row="2" Background="#EBF8FF" BorderBrush="#BEE3F8"
                BorderThickness="0,1,0,0" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Foreground="#2C5282" FontSize="12" Text="장비 금일: "/>
                    <TextBlock Foreground="#2C5282" FontSize="12" FontWeight="Bold"
                               Text="{Binding TotalTodayEquipment}"/>
                    <TextBlock Foreground="#2C5282" FontSize="12" Text="대　　공사 인원: "/>
                    <TextBlock Foreground="#2C5282" FontSize="12" FontWeight="Bold"
                               Text="{Binding TotalTodayPersonnel}"/>
                    <TextBlock Foreground="#2C5282" FontSize="12" Text="명　　TBM 합계: "/>
                    <TextBlock Foreground="#2C5282" FontSize="12" FontWeight="Bold"
                               Text="{Binding TotalTodayPersonnelWithSujangjae}"/>
                    <TextBlock Foreground="#2C5282" FontSize="12" Text="명"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Command="{Binding GenerateCommand}"
                        Content="📄  파일 생성"
                        Width="120" Height="34"
                        Background="#2B6CB0" Foreground="White"
                        FontSize="13" FontWeight="SemiBold"
                        BorderThickness="0" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background"  Value="#2B6CB0"/>
                            <Setter Property="Foreground"  Value="White"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="4" Padding="12,0">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#2C5282"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="#1A365D"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
