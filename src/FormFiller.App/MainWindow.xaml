<Window x:Class="FormFiller.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FormFiller.App.ViewModels"
        Title="서식 채우기" Height="780" Width="800"
        MinHeight="600" MinWidth="680"
        FontFamily="Malgun Gothic" FontSize="13">

    <!-- DataContext: 이 창이 데이터를 받아 올 ViewModel을 지정한다.
         Unity에서 GetComponent<MyScript>()와 비슷하게,
         XAML 안의 모든 {Binding ...}은 여기서 가져온다. -->
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <!-- 섹션 헤더 GroupBox 스타일 -->
        <Style TargetType="GroupBox">
            <Setter Property="Margin"      Value="0,0,0,10"/>
            <Setter Property="Padding"     Value="8,6"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="Foreground"  Value="#2D3748"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
        </Style>
        <!-- 레이블 스타일 -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground"        Value="#4A5568"/>
            <Setter Property="Margin"            Value="0,0,6,0"/>
        </Style>
        <!-- 텍스트박스 기본 스타일 -->
        <Style TargetType="TextBox">
            <Setter Property="Padding"      Value="4,3"/>
            <Setter Property="BorderBrush"  Value="#CBD5E0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <!-- 읽기 전용 셀 색상 (전일·누계 열) -->
        <Style x:Key="ReadOnlyCellStyle" TargetType="TextBlock">
            <Setter Property="Background"        Value="#F7FAFC"/>
            <Setter Property="Foreground"        Value="#718096"/>
            <Setter Property="TextAlignment"     Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding"           Value="4,0"/>
        </Style>
        <!-- 입력 셀 색상 (금일 열) -->
        <Style x:Key="InputCellStyle" TargetType="TextBox">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Padding"       Value="4,2"/>
            <Setter Property="BorderBrush"   Value="#4299E1"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 헤더 -->
            <RowDefinition Height="*"/>     <!-- 본문 -->
            <RowDefinition Height="Auto"/>  <!-- 하단 버튼 -->
        </Grid.RowDefinitions>

        <!-- ─── 헤더 ─────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="#2B6CB0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 왼쪽: 앱 제목 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="서식 채우기" Foreground="White"
                               FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Foreground="#BEE3F8" FontSize="12" Margin="12,0,0,0"
                               VerticalAlignment="Center" Text="공사일보 · 출력일보 · TBM일지"/>
                </StackPanel>

                <!-- 오른쪽: 설정 버튼 -->
                <Button Grid.Column="1"
                        Content="⚙ 설정"
                        Click="OpenSettings_Click"
                        Margin="12,0,0,0"
                        Background="Transparent" Foreground="White"
                        BorderThickness="1" BorderBrush="#BEE3F8"
                        Padding="8,2" Cursor="Hand"
                        VerticalAlignment="Center">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background"  Value="Transparent"/>
                            <Setter Property="Foreground"  Value="White"/>
                            <Setter Property="BorderBrush" Value="#BEE3F8"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Cursor"      Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="3" Padding="8,2">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#2C5282"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="#1A365D"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- ─── 본문 (스크롤 가능) ───────────────────────────── -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,8">
            <StackPanel>

                <!-- 기본 정보 -->
                <GroupBox Header="기본 정보">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="날짜"
                                   Style="{StaticResource LabelStyle}"/>
                        <!-- DatePicker: 달력 팝업으로 날짜를 고른다.
                             SelectedDate에 ViewModel의 TargetDate를 양방향 바인딩. -->
                        <DatePicker Grid.Column="1"
                                    SelectedDate="{Binding TargetDate, Mode=TwoWay}"
                                    FirstDayOfWeek="Monday"/>

                        <TextBlock Grid.Column="3" Text="날씨"
                                   Style="{StaticResource LabelStyle}"/>
                        <!-- ComboBox: ItemsSource로 목록을, SelectedItem으로 선택값을 바인딩 -->
                        <ComboBox Grid.Column="4"
                                  ItemsSource="{Binding WeatherOptions}"
                                  SelectedItem="{Binding Weather, Mode=TwoWay}"/>
                    </Grid>
                </GroupBox>

                <!-- 작업사항 -->
                <GroupBox Header="작업사항">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ── 금일 작업사항 ── -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="금일 작업사항"
                                       Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>

                            <!-- 항목 목록: 각 항목은 TextBox + 삭제(×) 버튼 한 줄 -->
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding TodayWorkItems}"
                                          MinHeight="60">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- 항목 텍스트 입력 -->
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Padding="4,3" BorderBrush="#CBD5E0"/>
                                            <!-- 삭제 버튼 -->
                                            <Button Grid.Column="1"
                                                    Content="×"
                                                    Command="{Binding RemoveCommand}"
                                                    Width="24" Height="24" Margin="4,0,0,0"
                                                    Background="#FED7D7" Foreground="#C53030"
                                                    BorderThickness="0" FontSize="14"
                                                    Cursor="Hand" VerticalAlignment="Center"
                                                    ToolTip="항목 삭제">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="#FED7D7"/>
                                                        <Setter Property="Foreground" Value="#C53030"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}"
                                                                            CornerRadius="3">
                                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                                          VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="#FC8181"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 항목 추가 버튼 -->
                            <Button Grid.Row="2"
                                    Content="+ 항목 추가"
                                    Command="{Binding AddTodayWorkCommand}"
                                    HorizontalAlignment="Left" Margin="0,4,0,0"
                                    Padding="8,3" Background="#EBF8FF"
                                    Foreground="#2B6CB0" BorderBrush="#BEE3F8"
                                    BorderThickness="1" Cursor="Hand" FontSize="12">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#EBF8FF"/>
                                        <Setter Property="Foreground" Value="#2B6CB0"/>
                                        <Setter Property="BorderBrush" Value="#BEE3F8"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#BEE3F8"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <!-- ── 명일 작업사항 ── -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="명일 작업사항"
                                       Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>

                            <!-- 항목 목록: 각 항목은 TextBox + 삭제(×) 버튼 한 줄 -->
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding TomorrowWorkItems}"
                                          MinHeight="60">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- 항목 텍스트 입력 -->
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Padding="4,3" BorderBrush="#CBD5E0"/>
                                            <!-- 삭제 버튼 -->
                                            <Button Grid.Column="1"
                                                    Content="×"
                                                    Command="{Binding RemoveCommand}"
                                                    Width="24" Height="24" Margin="4,0,0,0"
                                                    Background="#FED7D7" Foreground="#C53030"
                                                    BorderThickness="0" FontSize="14"
                                                    Cursor="Hand" VerticalAlignment="Center"
                                                    ToolTip="항목 삭제">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="#FED7D7"/>
                                                        <Setter Property="Foreground" Value="#C53030"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}"
                                                                            CornerRadius="3">
                                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                                          VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="#FC8181"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 항목 추가 버튼 -->
                            <Button Grid.Row="2"
                                    Content="+ 항목 추가"
                                    Command="{Binding AddTomorrowWorkCommand}"
                                    HorizontalAlignment="Left" Margin="0,4,0,0"
                                    Padding="8,3" Background="#EBF8FF"
                                    Foreground="#2B6CB0" BorderBrush="#BEE3F8"
                                    BorderThickness="1" Cursor="Hand" FontSize="12">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#EBF8FF"/>
                                        <Setter Property="Foreground" Value="#2B6CB0"/>
                                        <Setter Property="BorderBrush" Value="#BEE3F8"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#BEE3F8"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                    </Grid>
                </GroupBox>

                <!-- 장비 투입현황 -->
                <GroupBox Header="장비 투입현황">
                    <!-- DataGrid: 컬렉션을 표 형태로 보여 준다.
                         AutoGenerateColumns="False": 열을 직접 정의한다.
                         CanUserAddRows="False": 행 추가 비활성화 (장비 목록은 고정). -->
                    <DataGrid ItemsSource="{Binding Equipment}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserResizeRows="False" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EDF2F7"
                              RowHeight="30" SelectionMode="Single"
                              BorderBrush="#CBD5E0" BorderThickness="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="장비명" Binding="{Binding Name}"
                                                Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="규격"   Binding="{Binding Spec}"
                                                Width="80"  IsReadOnly="True"/>

                            <!-- 전일(대): 읽기 전용, 회색 배경 -->
                            <DataGridTemplateColumn Header="전일(대)" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding PrevDayCount}"
                                                   Style="{StaticResource ReadOnlyCellStyle}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 금일(대): 직접 입력 -->
                            <DataGridTemplateColumn Header="금일(대) ✏" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TodayCount}"
                                                   TextAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding TodayCount, Mode=TwoWay,
                                                         UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource InputCellStyle}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <!-- 누계(대): 읽기 전용 (전일 + 금일 자동 계산) -->
                            <DataGridTemplateColumn Header="누계(대)" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TotalCount}"
                                                   Style="{StaticResource ReadOnlyCellStyle}"
                                                   FontWeight="SemiBold"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>

                <!-- 인원 투입현황 -->
                <GroupBox Header="인원 투입현황">
                    <DataGrid ItemsSource="{Binding Personnel}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserResizeRows="False" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EDF2F7"
                              RowHeight="30" SelectionMode="Single"
                              BorderBrush="#CBD5E0" BorderThickness="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="직종" Binding="{Binding Role}"
                                                Width="100" IsReadOnly="True"/>

                            <DataGridTemplateColumn Header="전일누계(명)" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding PrevCumulativeCount}"
                                                   Style="{StaticResource ReadOnlyCellStyle}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="금일(명) ✏" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TodayCount}"
                                                   TextAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding TodayCount, Mode=TwoWay,
                                                         UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource InputCellStyle}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="총누계(명)" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TotalCumulativeCount}"
                                                   Style="{StaticResource ReadOnlyCellStyle}"
                                                   FontWeight="SemiBold"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>

                <!-- 수장재팀 별도 인원 -->
                <GroupBox Header="수장재팀 인원 (별도)">
                    <DataGrid ItemsSource="{Binding SujangjaePersonnel}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserResizeRows="False" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EDF2F7"
                              RowHeight="30" SelectionMode="Single"
                              BorderBrush="#CBD5E0" BorderThickness="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="직종" Binding="{Binding Role}"
                                                Width="100" IsReadOnly="True"/>

                            <DataGridTemplateColumn Header="전일누계(명)" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding PrevCumulativeCount}"
                                                   Style="{StaticResource ReadOnlyCellStyle}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="금일(명) ✏" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TodayCount}"
                                                   TextAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding TodayCount, Mode=TwoWay,
                                                         UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource InputCellStyle}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="총누계(명)" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TotalCumulativeCount}"
                                                   Style="{StaticResource ReadOnlyCellStyle}"
                                                   FontWeight="SemiBold"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>

                <!-- 오늘 생성할 문서 목록 -->
                <GroupBox Header="오늘 생성할 문서">
                    <ItemsControl ItemsSource="{Binding DocumentDueList}" Margin="4,2">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 체크박스: 이 문서를 생성할지 여부 -->
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              VerticalAlignment="Center" Margin="0,0,8,0"/>

                                    <!-- 문서 이름 -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Name}"
                                               VerticalAlignment="Center"
                                               Foreground="#2D3748"/>

                                    <!-- 주기 레이블 (매일, 2주마다 등) -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding FrequencyLabel}"
                                               Foreground="#718096" FontSize="11"
                                               VerticalAlignment="Center" Margin="8,0"/>

                                    <!-- 다음 생성일 (IsDue=false 일 때만 표시) -->
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding NextDueText}"
                                               Foreground="#E53E3E" FontSize="11"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </GroupBox>

                <!-- ════════════════════════════════════════════════
                     사진 섹션 (PhotoSheet가 설정된 문서에만 표시)
                     ════════════════════════════════════════════════ -->
                <GroupBox Header="📷 사진대지 사진"
                          Visibility="{Binding HasPhotoSlots,
                                       Converter={StaticResource BoolVis}}">
                    <StackPanel>
                        <TextBlock Foreground="#718096" FontSize="11" Margin="0,0,0,8"
                                   Text="이미지 파일을 슬롯에 드래그하거나 클릭해서 선택하세요. 생성 시 슬롯 크기에 맞게 가득채우기로 삽입됩니다."/>

                        <!-- 슬롯 카드 목록 (가로 흐름) -->
                        <ItemsControl ItemsSource="{Binding PhotoSlots}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PhotoSlotViewModel}">
                                    <!-- 슬롯 카드 -->
                                    <Border Width="160" Height="130"
                                            Margin="0,0,10,10"
                                            BorderBrush="#CBD5E0" BorderThickness="1"
                                            CornerRadius="4"
                                            Background="#F7FAFC"
                                            AllowDrop="True"
                                            Drop="PhotoSlot_Drop"
                                            DragOver="PhotoSlot_DragOver"
                                            Cursor="Hand">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#F7FAFC"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasPhoto}" Value="True">
                                                        <Setter Property="Background" Value="#EBF8FF"/>
                                                        <Setter Property="BorderBrush" Value="#4299E1"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid>
                                            <!-- 사진 선택 영역 (클릭 → BrowseCommand) -->
                                            <Button Command="{Binding BrowseCommand}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    HorizontalContentAlignment="Stretch"
                                                    VerticalContentAlignment="Stretch"
                                                    Padding="0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <ContentPresenter/>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <Grid>
                                                    <!-- 사진 없음: 플레이스홀더 -->
                                                    <StackPanel VerticalAlignment="Center"
                                                                HorizontalAlignment="Center"
                                                                Visibility="{Binding PlaceholderVisible,
                                                                             Converter={StaticResource BoolVis}}">
                                                        <TextBlock Text="🖼" FontSize="28"
                                                                   HorizontalAlignment="Center"/>
                                                        <TextBlock Text="클릭 또는 드래그"
                                                                   Foreground="#A0AEC0" FontSize="11"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,4,0,0"/>
                                                    </StackPanel>

                                                    <!-- 사진 있음: 썸네일 -->
                                                    <Image Source="{Binding Thumbnail}"
                                                           Stretch="UniformToFill"
                                                           Width="160" Height="105"
                                                           VerticalAlignment="Top">
                                                        <Image.Style>
                                                            <Style TargetType="Image">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasPhoto}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Image.Style>
                                                    </Image>
                                                </Grid>
                                            </Button>

                                            <!-- 슬롯 레이블 + 지우기 버튼 (하단) -->
                                            <Grid VerticalAlignment="Bottom"
                                                  Height="25"
                                                  Background="#00000018">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Label}"
                                                           Foreground="#2D3748" FontSize="11"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           Margin="6,0"/>
                                                <!-- 지우기 버튼 (사진 있을 때만) -->
                                                <Button Grid.Column="1"
                                                        Command="{Binding ClearCommand}"
                                                        Content="✕"
                                                        Width="22" Height="22"
                                                        FontSize="10"
                                                        Background="#FEB2B2"
                                                        Foreground="#C53030"
                                                        BorderThickness="0"
                                                        Margin="0,0,2,0"
                                                        VerticalAlignment="Center"
                                                        Cursor="Hand">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="{TemplateBinding Background}"
                                                                                CornerRadius="11"
                                                                                Padding="2">
                                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                                              VerticalAlignment="Center"/>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasPhoto}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- ─── 하단 합계 + 생성 버튼 ───────────────────────── -->
        <Border Grid.Row="2" Background="#EBF8FF" BorderBrush="#BEE3F8"
                BorderThickness="0,1,0,0" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 합계 요약 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Foreground="#2C5282" FontSize="12" Text="장비 금일: "/>
                    <TextBlock Foreground="#2C5282" FontSize="12" FontWeight="Bold"
                               Text="{Binding TotalTodayEquipment}"/>
                    <TextBlock Foreground="#2C5282" FontSize="12" Text="대　　공사 인원: "/>
                    <TextBlock Foreground="#2C5282" FontSize="12" FontWeight="Bold"
                               Text="{Binding TotalTodayPersonnel}"/>
                    <TextBlock Foreground="#2C5282" FontSize="12" Text="명　　수장재: "/>
                    <TextBlock Foreground="#2C5282" FontSize="12" FontWeight="Bold"
                               Text="{Binding SujangjaePersonnel[0].TodayCount}"/>
                    <TextBlock Foreground="#2C5282" FontSize="12" Text="명　　TBM 합계: "/>
                    <TextBlock Foreground="#2C5282" FontSize="12" FontWeight="Bold"
                               Text="{Binding TotalTodayPersonnelWithSujangjae}"/>
                    <TextBlock Foreground="#2C5282" FontSize="12" Text="명"/>
                </StackPanel>

                <!-- 생성 버튼 -->
                <Button Grid.Column="1"
                        Command="{Binding GenerateCommand}"
                        Content="📄  파일 생성"
                        Width="120" Height="34"
                        Background="#2B6CB0" Foreground="White"
                        FontSize="13" FontWeight="SemiBold"
                        BorderThickness="0" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background"  Value="#2B6CB0"/>
                            <Setter Property="Foreground"  Value="White"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="4" Padding="12,0">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#2C5282"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="#1A365D"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
