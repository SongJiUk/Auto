<Window x:Class="FormFiller.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FormFiller.App.ViewModels"
        Title="서식 채우기" Height="820" Width="1000"
        MinHeight="600" MinWidth="820"
        FontFamily="Malgun Gothic" FontSize="13">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <Style TargetType="GroupBox">
            <Setter Property="Margin"      Value="0,0,0,10"/>
            <Setter Property="Padding"     Value="8,6"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="Foreground"  Value="#2D3748"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
        </Style>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground"        Value="#4A5568"/>
            <Setter Property="Margin"            Value="0,0,6,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding"         Value="4,3"/>
            <Setter Property="BorderBrush"     Value="#CBD5E0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <!-- 읽기 전용 셀 (회색) -->
        <Style x:Key="ROCell" TargetType="TextBlock">
            <Setter Property="Background"        Value="#F7FAFC"/>
            <Setter Property="Foreground"        Value="#718096"/>
            <Setter Property="TextAlignment"     Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding"           Value="4,0"/>
        </Style>
        <!-- 편집 가능 셀 -->
        <!-- 표 칸: 한 번 클릭하면 바로 고칠 수 있게 (원래는 두 번 클릭해야 했음) -->
        <Style TargetType="DataGridCell">
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Cell_PreviewMouseLeftButtonDown"/>
        </Style>

        <Style x:Key="EditCell" TargetType="TextBox">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Padding"       Value="4,2"/>
            <Setter Property="BorderBrush"   Value="#4299E1"/>
        </Style>
        <!-- 삭제 버튼 (DataGrid 행) -->
        <Style x:Key="DelBtn" TargetType="Button">
            <Setter Property="Background"    Value="#FED7D7"/>
            <Setter Property="Foreground"    Value="#C53030"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width"         Value="22"/>
            <Setter Property="Height"        Value="22"/>
            <Setter Property="FontSize"      Value="12"/>
            <Setter Property="Cursor"        Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FC8181"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 추가 버튼 -->
        <Style x:Key="AddBtn" TargetType="Button">
            <Setter Property="Background"    Value="#EBF8FF"/>
            <Setter Property="Foreground"    Value="#2B6CB0"/>
            <Setter Property="BorderBrush"   Value="#BEE3F8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"       Value="8,3"/>
            <Setter Property="Cursor"        Value="Hand"/>
            <Setter Property="FontSize"      Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#BEE3F8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════ 항목 입력 카드 (블록 종류마다) ══════════ -->
        <Style x:Key="BlockCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <!-- 카드 제목 줄: 아이콘 · 이름 · 쓰는 문서 -->
        <DataTemplate x:Key="BlockHeader">
            <DockPanel Margin="0,0,0,6">
                <TextBlock DockPanel.Dock="Right" Text="{Binding UsedIn}" FontSize="11" Foreground="#A0AEC0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Icon}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#2D3748" VerticalAlignment="Center"/>
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ValueInputViewModel}">
            <Border Style="{StaticResource BlockCard}">
                <StackPanel>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource BlockHeader}"/>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Suffix}" Margin="6,0,0,0" VerticalAlignment="Center"
                                   Foreground="#718096" Visibility="{Binding HasSuffix, Converter={StaticResource BoolVis}}"/>
                        <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:LinesInputViewModel}">
            <Border Style="{StaticResource BlockCard}">
                <StackPanel>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource BlockHeader}"/>
                    <ItemsControl ItemsSource="{Binding Lines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,4">
                                    <Button DockPanel.Dock="Right" Content="✕" Command="{Binding RemoveCommand}"
                                            Style="{StaticResource DelBtn}" Margin="6,0,0,0"/>
                                    <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <Button Content="+ 줄 추가" Command="{Binding AddLineCommand}" Style="{StaticResource AddBtn}" Margin="0,0,6,0"/>
                        <Button Content="☰ 항목 선택" Command="{Binding PickCommand}" Style="{StaticResource AddBtn}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:CounterInputViewModel}">
            <Border Style="{StaticResource BlockCard}">
                <StackPanel>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource BlockHeader}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="전일 누계" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding Prev, UpdateSourceTrigger=LostFocus}" Width="70" Style="{StaticResource EditCell}"
                                 ToolTip="어제 파일에서 읽은 누계. 처음 쓰는 날이면 직접 입력"/>
                        <TextBlock Text="+  오늘" Style="{StaticResource LabelStyle}" Margin="12,0,6,0"/>
                        <TextBox Text="{Binding Today, UpdateSourceTrigger=PropertyChanged}" Width="70" Style="{StaticResource EditCell}"/>
                        <TextBlock Text="=  누계" Style="{StaticResource LabelStyle}" Margin="12,0,6,0"/>
                        <TextBlock Text="{Binding Total}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#2B6CB0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:TableInputViewModel}">
            <Border Style="{StaticResource BlockCard}">
                <StackPanel>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource BlockHeader}"/>
                    <TextBlock Text="{Binding RosterNote}" FontSize="11" Foreground="#2B6CB0" Margin="0,0,0,4"
                               Visibility="{Binding FromRoster, Converter={StaticResource BoolVis}}"/>
                    <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="28"
                              BorderBrush="#E2E8F0" HorizontalGridLinesBrush="#EDF2F7">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="이름" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridTextColumn Header="규격" Binding="{Binding Spec, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                            <DataGridTextColumn Header="전일" Binding="{Binding Prev, UpdateSourceTrigger=LostFocus}" Width="70"/>
                            <DataGridTextColumn Header="금일" Binding="{Binding Today, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                            <DataGridTextColumn Header="누계" Binding="{Binding Total, Mode=OneWay}" Width="70" IsReadOnly="True"/>
                            <DataGridTemplateColumn Width="34">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕" Command="{Binding RemoveCommand}" Style="{StaticResource DelBtn}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#4A5568">
                            <Run Text="금일 합계 "/><Run Text="{Binding TodaySum, Mode=OneWay}" FontWeight="SemiBold"/>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="+ 줄 추가" Command="{Binding AddRowCommand}" Style="{StaticResource AddBtn}" Margin="0,0,6,0"/>
                            <Button Content="↻ 금일을 어제와 같게" Command="{Binding CopyLastTodayCommand}" Style="{StaticResource AddBtn}"
                                    Visibility="{Binding TodayEditable, Converter={StaticResource BoolVis}}"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:RosterInputViewModel}">
            <Border Style="{StaticResource BlockCard}">
                <StackPanel>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource BlockHeader}"/>
                    <TextBlock Text="오늘 나온 사람을 체크하세요. 체크한 사람이 위에서부터 순서대로 들어갑니다."
                               FontSize="11" Foreground="#718096" Margin="0,0,0,4"/>
                    <DataGrid ItemsSource="{Binding People}" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="28" MaxHeight="360"
                              BorderBrush="#E2E8F0" HorizontalGridLinesBrush="#EDF2F7">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="출근" Width="44">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="성명" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                            <DataGridTextColumn Header="직종" Binding="{Binding Job, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                            <DataGridTextColumn Header="작업내용" Binding="{Binding Task, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridTemplateColumn Width="34">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕" Command="{Binding RemoveCommand}" Style="{StaticResource DelBtn}"
                                                ToolTip="사람 목록에서 지우기"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <DockPanel Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Button Content="+ 사람 추가" Command="{Binding AddPersonCommand}" Style="{StaticResource AddBtn}" Margin="0,0,6,0"/>
                            <Button Content="모두 체크" Command="{Binding CheckAllCommand}" Style="{StaticResource AddBtn}" Margin="0,0,6,0"/>
                            <Button Content="모두 해제" Command="{Binding UncheckAllCommand}" Style="{StaticResource AddBtn}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding CountText}" TextAlignment="Right" VerticalAlignment="Center"
                                   Foreground="#2B6CB0" TextWrapping="Wrap" Margin="8,0,0,0"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PhotosInputViewModel}">
            <Border Style="{StaticResource BlockCard}">
                <StackPanel>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource BlockHeader}"/>
                    <TextBlock Text="{Binding Note}" FontSize="11" Foreground="#718096" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding Slots}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PhotoPickViewModel}">
                                <StackPanel Width="190" Margin="0,0,10,8">
                                    <DockPanel Margin="0,0,0,3">
                                        <Button DockPanel.Dock="Right" Content="✕" Command="{Binding ClearCommand}"
                                                Style="{StaticResource DelBtn}" ToolTip="사진 빼기"
                                                Visibility="{Binding HasPhoto, Converter={StaticResource BoolVis}}"/>
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="#2D3748" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <!-- 누르면 파일 고르기, 사진을 끌어다 놓아도 된다 -->
                                    <Border Height="130" CornerRadius="6" BorderThickness="1" BorderBrush="#CBD5E0" Background="#F7FAFC"
                                            Cursor="Hand" AllowDrop="True" DragOver="PhotoSlot_DragOver" Drop="BlockPhoto_Drop"
                                            ToolTip="눌러서 사진 고르기 / 사진 파일을 끌어다 놓기">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding BrowseCommand}"/>
                                        </Border.InputBindings>
                                        <Grid>
                                            <TextBlock Text="📷&#x0a;눌러서 고르기&#x0a;또는 끌어다 놓기" TextAlignment="Center"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#A0AEC0" FontSize="11"/>
                                            <!-- 사진이 있으면 안내 글자를 덮는다 -->
                                            <Border Background="#F7FAFC" Margin="1" Visibility="{Binding HasPhoto, Converter={StaticResource BoolVis}}">
                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{Binding FileName}" FontSize="10" Foreground="#A0AEC0" TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,0" ToolTip="{Binding Path}"/>
                                    <DockPanel Margin="0,2,0,0" Visibility="{Binding HasCaption, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="설명" Style="{StaticResource LabelStyle}" FontSize="11"/>
                                        <TextBox Text="{Binding Caption, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="3,1"
                                                 ToolTip="사진 아래 설명 칸에 들어갑니다 (예: 일일 TBM(수장재))"/>
                                    </DockPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="📂 폴더에서 오늘 사진 불러오기" Command="{Binding ImportCommand}" Style="{StaticResource AddBtn}"
                            HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:CalcInputViewModel}">
            <Border Style="{StaticResource BlockCard}" Background="#F7FAFC">
                <StackPanel>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource BlockHeader}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Formula}" Foreground="#718096" VerticalAlignment="Center"/>
                        <TextBlock Text="  →  " Foreground="#A0AEC0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Result}" FontWeight="SemiBold" Foreground="#2B6CB0" VerticalAlignment="Center"/>
                        <TextBlock Text="  (자동 계산)" FontSize="11" Foreground="#A0AEC0" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ─── 헤더 + 구글 드라이브 경고 띠 ─────────────────────── -->
        <StackPanel Grid.Row="0">
        <Border Background="#2B6CB0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 사용법 버튼 -->
                <Button Grid.Column="4" Content="❓ 사용법" Click="OpenHelp_Click"
                        Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent" BorderBrush="#BEE3F8" BorderThickness="1"
                                    CornerRadius="3" Padding="8,2">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.Foreground="White"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#2C5282"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="서식 채우기" Foreground="White"
                               FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Foreground="#BEE3F8" FontSize="12" Margin="12,0,0,0"
                               VerticalAlignment="Center" Text="공사일보 · 출력일보 · TBM일지"/>
                </StackPanel>

                <!-- 구글 드라이브 점검·폴더 설정 버튼 -->
                <Button Grid.Column="1" Content="☁ 구글 드라이브" Click="OpenDrive_Click"
                        Margin="0,0,8,0" VerticalAlignment="Center" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent" BorderBrush="#BEE3F8" BorderThickness="1"
                                    CornerRadius="3" Padding="8,2">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.Foreground="White"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#2C5282"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- AI 도우미 버튼 -->
                <Button Grid.Column="2"
                        Content="🤖 AI 도우미"
                        Command="{Binding OpenAiAssistantCommand}"
                        Margin="0,0,8,0"
                        Background="Transparent" Foreground="White"
                        BorderThickness="1" BorderBrush="#BEE3F8"
                        Padding="8,2" Cursor="Hand"
                        VerticalAlignment="Center">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background"  Value="Transparent"/>
                            <Setter Property="Foreground"  Value="White"/>
                            <Setter Property="BorderBrush" Value="#BEE3F8"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Cursor"      Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="3" Padding="8,2">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#2C5282"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- 설정 버튼 -->
                <Button Grid.Column="3"
                        Content="⚙ 설정"
                        Click="OpenSettings_Click"
                        Background="Transparent" Foreground="White"
                        BorderThickness="1" BorderBrush="#BEE3F8"
                        Padding="8,2" Cursor="Hand"
                        VerticalAlignment="Center">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background"  Value="Transparent"/>
                            <Setter Property="Foreground"  Value="White"/>
                            <Setter Property="BorderBrush" Value="#BEE3F8"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Cursor"      Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="3" Padding="8,2">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#2C5282"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- 시작할 때 드라이브 점검에서 중요한 문제가 있으면 보인다. 누르면 구글 드라이브 창 -->
        <Border x:Name="DriveBanner" Visibility="Collapsed" Background="#FEEBC8" BorderBrush="#F6AD55"
                BorderThickness="0,0,0,1" Padding="16,6" Cursor="Hand" MouseLeftButtonUp="DriveBanner_Click">
            <TextBlock x:Name="DriveBannerText" Foreground="#7B341E" TextWrapping="Wrap"/>
        </Border>
        </StackPanel>

        <!-- ─── 본문: 왼쪽 단계 목록 + 오른쪽 고른 단계의 입력 ─────────── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 단계 목록. 오늘 만들 문서에 필요 없는 단계는 숨긴다 -->
            <Border Grid.Column="0" Background="#F7FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
                <ListBox ItemsSource="{Binding Steps}" SelectedItem="{Binding CurrentStep, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0" Padding="8,10"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolVis}}"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Margin" Value="0,0,0,4"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="10,8">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#EDF2F7"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#EBF8FF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:StepItem}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- 번호 동그라미 (다 했으면 초록 ✔) -->
                                <Border Width="24" Height="24" CornerRadius="12" Margin="0,0,10,0"
                                        VerticalAlignment="Top">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#CBD5E0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                    <Setter Property="Background" Value="#38A169"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Badge}" Foreground="White" FontWeight="Bold"
                                               FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#2D3748"/>
                                    <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="#718096"
                                               Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

        <ScrollViewer x:Name="BodyScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="14,10">
            <StackPanel>

                <!-- ══════════════ 단계: 문서 · 기본 정보 ══════════════ -->
                <StackPanel Visibility="{Binding ShowDocsStep, Converter={StaticResource BoolVis}}">

                <!-- 오늘 생성할 문서 (먼저 고르면 필요한 입력만 보인다).
                     매일 업무와 주기 업무(매주·매월 등)를 나눠 보여 준다 -->
                <GroupBox Header="오늘 생성할 문서">
                    <StackPanel>
                        <TextBlock Text="📅 매일 업무" FontWeight="SemiBold" Foreground="#2B6CB0" Margin="4,2,0,2"
                                   Visibility="{Binding HasDailyDocs, Converter={StaticResource BoolVis}}"/>
                        <ItemsControl ItemsSource="{Binding DailyDocs}" Margin="4,2">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- 이름을 눌러도 체크되도록 이름을 체크박스 안에 넣는다 -->
                                        <CheckBox Grid.Column="0" Grid.ColumnSpan="2"
                                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                  VerticalAlignment="Center" VerticalContentAlignment="Top"
                                                  Cursor="Hand">
                                            <StackPanel Margin="4,0,0,0">
                                                <TextBlock Text="{Binding Name}" Foreground="#2D3748"/>
                                                <TextBlock Text="{Binding Warning}" Foreground="#E53E3E" FontSize="11"
                                                           TextWrapping="Wrap" Margin="0,2,0,0"
                                                           Visibility="{Binding HasWarning, Converter={StaticResource BoolVis}}"/>
                                            </StackPanel>
                                        </CheckBox>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding FrequencyLabel}"
                                                   Foreground="#718096" FontSize="11"
                                                   VerticalAlignment="Center" Margin="8,0"/>
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding NextDueText}"
                                                   Foreground="#E53E3E" FontSize="11"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="🗓 주기 업무 (매주 · 매월 등)" FontWeight="SemiBold" Foreground="#2B6CB0" Margin="4,10,0,2"
                                   Visibility="{Binding HasPeriodicDocs, Converter={StaticResource BoolVis}}"/>
                        <ItemsControl ItemsSource="{Binding PeriodicDocs}" Margin="4,2"
                                      Visibility="{Binding HasPeriodicDocs, Converter={StaticResource BoolVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- 이름을 눌러도 체크되도록 이름을 체크박스 안에 넣는다 -->
                                        <CheckBox Grid.Column="0" Grid.ColumnSpan="2"
                                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                  VerticalAlignment="Center" VerticalContentAlignment="Top"
                                                  Cursor="Hand">
                                            <StackPanel Margin="4,0,0,0">
                                                <TextBlock Text="{Binding Name}" Foreground="#2D3748"/>
                                                <TextBlock Text="{Binding Warning}" Foreground="#E53E3E" FontSize="11"
                                                           TextWrapping="Wrap" Margin="0,2,0,0"
                                                           Visibility="{Binding HasWarning, Converter={StaticResource BoolVis}}"/>
                                            </StackPanel>
                                        </CheckBox>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding FrequencyLabel}"
                                                   Foreground="#718096" FontSize="11"
                                                   VerticalAlignment="Center" Margin="8,0"/>
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding StatusText}" FontSize="11"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#DD6B20"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDoneThisPeriod}" Value="True">
                                                            <Setter Property="Foreground" Value="#38A169"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="체크한 문서에 필요한 입력만 왼쪽 단계에 나타납니다."
                                   FontWeight="Normal" FontSize="11" Foreground="#A0AEC0" Margin="4,6,0,0"/>
                    </StackPanel>
                </GroupBox>

                <!-- 기본 정보 -->
                <GroupBox Header="기본 정보">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="날짜" Style="{StaticResource LabelStyle}"/>
                        <!-- 하루씩 앞뒤로, [오늘] 로 바로 돌아오기 -->
                        <Button Grid.Column="1" Content="◀" Width="28" Margin="0,0,4,0" ToolTip="하루 전"
                                Command="{Binding PrevDayCommand}" Background="White" BorderBrush="#CBD5E0" Cursor="Hand"/>
                        <DatePicker Grid.Column="2"
                                    SelectedDate="{Binding TargetDate, Mode=TwoWay}"
                                    FirstDayOfWeek="Monday"/>
                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <Button Content="▶" Width="28" Margin="4,0,0,0" ToolTip="하루 뒤"
                                    Command="{Binding NextDayCommand}" Background="White" BorderBrush="#CBD5E0" Cursor="Hand"/>
                            <Button Content="오늘" Padding="10,0" Margin="4,0,0,0"
                                    Command="{Binding TodayCommand}" Background="White" BorderBrush="#CBD5E0" Cursor="Hand"/>
                        </StackPanel>
                        <TextBlock Grid.Column="5" Text="날씨" Style="{StaticResource LabelStyle}"
                                   Visibility="{Binding UsesWeather, Converter={StaticResource BoolVis}}"/>
                        <ComboBox Grid.Column="6"
                                  ItemsSource="{Binding WeatherOptions}"
                                  SelectedItem="{Binding Weather, Mode=TwoWay}"
                                  Visibility="{Binding UsesWeather, Converter={StaticResource BoolVis}}"/>
                    </Grid>
                </GroupBox>

                <!-- 폰 입력 (폰 앱이 드라이브 inbox 폴더에 올린 것을 화면에 합친다) -->
                <GroupBox Header="폰 입력">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="📱 폰 입력 불러오기" Padding="12,4"
                                Command="{Binding LoadPhoneInputCommand}"
                                Background="White" BorderBrush="#CBD5E0" Cursor="Hand"/>
                        <TextBlock Text="{Binding PhoneStatusText}" Foreground="#2B6CB0" FontSize="12"
                                   VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </GroupBox>
                </StackPanel>

                <!-- ══════════════ 단계: 항목 입력 (블록) ══════════════
                     설정에서 만든 블록마다 카드 하나. 카드 모양은 Window.Resources 의 DataTemplate 이 종류마다 정한다 -->
                <StackPanel Visibility="{Binding ShowBlocksStep, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="설정에서 만든 항목입니다. 같은 이름 항목은 여러 문서에 한 번에 들어갑니다."
                               Foreground="#718096" FontSize="12" Margin="2,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding BlockInputs}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolVis}}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                </StackPanel>

                <!-- ══════════════ 단계: 작업사항 ══════════════ -->
                <GroupBox Header="작업사항"
                          Visibility="{Binding ShowWorkStep, Converter={StaticResource BoolVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ── 금일 (오전/오후 탭) ── -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="금일 작업사항"
                                       Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                            <TabControl Grid.Row="1" BorderBrush="#CBD5E0">
                                <!-- 오전 탭 -->
                                <TabItem Header="오전">
                                    <StackPanel Margin="0,4,0,0">
                                        <ItemsControl ItemsSource="{Binding TodayMorningItems}" MinHeight="50">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Grid.Column="0"
                                                                 Text="{Binding Text, Mode=TwoWay,
                                                                        UpdateSourceTrigger=PropertyChanged}"
                                                                 Padding="4,3" BorderBrush="#CBD5E0"/>
                                                        <Button Grid.Column="1" Content="×"
                                                                Command="{Binding RemoveCommand}"
                                                                Style="{StaticResource DelBtn}"
                                                                Margin="4,0,0,0" ToolTip="삭제"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Button Content="+ 직접 추가"
                                                    Command="{Binding AddMorningWorkCommand}"
                                                    Style="{StaticResource AddBtn}"/>
                                            <Button Content="☰ 항목 선택"
                                                    Command="{Binding PickMorningWorkCommand}"
                                                    Style="{StaticResource AddBtn}"
                                                    Margin="6,0,0,0"
                                                    Background="#F0FFF4" Foreground="#276749"
                                                    BorderBrush="#9AE6B4"/>
                                        </StackPanel>
                                    </StackPanel>
                                </TabItem>
                                <!-- 오후 탭 -->
                                <TabItem Header="오후">
                                    <StackPanel Margin="0,4,0,0">
                                        <ItemsControl ItemsSource="{Binding TodayAfternoonItems}" MinHeight="50">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Grid.Column="0"
                                                                 Text="{Binding Text, Mode=TwoWay,
                                                                        UpdateSourceTrigger=PropertyChanged}"
                                                                 Padding="4,3" BorderBrush="#CBD5E0"/>
                                                        <Button Grid.Column="1" Content="×"
                                                                Command="{Binding RemoveCommand}"
                                                                Style="{StaticResource DelBtn}"
                                                                Margin="4,0,0,0" ToolTip="삭제"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Button Content="+ 직접 추가"
                                                    Command="{Binding AddAfternoonWorkCommand}"
                                                    Style="{StaticResource AddBtn}"/>
                                            <Button Content="☰ 항목 선택"
                                                    Command="{Binding PickAfternoonWorkCommand}"
                                                    Style="{StaticResource AddBtn}"
                                                    Margin="6,0,0,0"
                                                    Background="#F0FFF4" Foreground="#276749"
                                                    BorderBrush="#9AE6B4"/>
                                        </StackPanel>
                                    </StackPanel>
                                </TabItem>
                            </TabControl>
                        </Grid>

                        <!-- ── 명일 작업사항 ── -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="명일 작업사항"
                                       Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding TomorrowWorkItems}" MinHeight="60">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding Text, Mode=TwoWay,
                                                            UpdateSourceTrigger=PropertyChanged}"
                                                     Padding="4,3" BorderBrush="#CBD5E0"/>
                                            <Button Grid.Column="1" Content="×"
                                                    Command="{Binding RemoveCommand}"
                                                    Style="{StaticResource DelBtn}"
                                                    Margin="4,0,0,0" ToolTip="삭제"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,0">
                                <Button Content="+ 직접 추가"
                                        Command="{Binding AddTomorrowWorkCommand}"
                                        Style="{StaticResource AddBtn}"/>
                                <Button Content="☰ 항목 선택"
                                        Command="{Binding PickTomorrowWorkCommand}"
                                        Style="{StaticResource AddBtn}"
                                        Margin="6,0,0,0"
                                        Background="#F0FFF4" Foreground="#276749"
                                        BorderBrush="#9AE6B4"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </GroupBox>

                <!-- ══════════════ 단계: 장비 · 인원 ══════════════ -->
                <StackPanel Visibility="{Binding ShowCrewStep, Converter={StaticResource BoolVis}}">

                <!-- 전일 값을 어디서 가져왔는지 / 첫날이면 기준을 직접 입력하라는 안내 -->
                <Border CornerRadius="6" Padding="12,9" Margin="0,0,0,10" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background"  Value="#FFFAF0"/>
                            <Setter Property="BorderBrush" Value="#FBD38D"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasPrevFile}" Value="True">
                                    <Setter Property="Background"  Value="#F0FFF4"/>
                                    <Setter Property="BorderBrush" Value="#9AE6B4"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding PrevSourceText}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding PrevSourceText}" TextWrapping="Wrap" FontSize="12" Foreground="#2D3748"/>
                </Border>

                <!-- 현장 구성이 매일 비슷하니 앞 날짜 금일 값을 한 번에 가져온다 -->
                <DockPanel Margin="0,0,0,8" Visibility="{Binding HasLastFileToday, Converter={StaticResource BoolVis}}">
                    <Button DockPanel.Dock="Left" Content="↻ 금일 칸을 전일과 같게"
                            Command="{Binding CopyLastFileTodayCommand}"
                            Padding="12,5" Background="#EBF8FF" Foreground="#2B6CB0" BorderBrush="#90CDF4" Cursor="Hand"/>
                    <TextBlock Text="앞 날짜 공사일보의 금일 대수·인원을 그대로 넣습니다. 넣은 뒤 다른 것만 고치세요."
                               VerticalAlignment="Center" Margin="10,0,0,0" FontSize="11" Foreground="#718096" TextWrapping="Wrap"/>
                </DockPanel>

                <!-- 장비 투입현황 -->
                <GroupBox Header="장비 투입현황"
                          Visibility="{Binding UsesEquipment, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                        <DataGrid ItemsSource="{Binding Equipment}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserResizeRows="False" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#EDF2F7"
                                  RowHeight="30" SelectionMode="Single"
                                  BorderBrush="#CBD5E0" BorderThickness="1">
                            <DataGrid.Columns>
                                <!-- 장비명: 편집 가능 -->
                                <DataGridTemplateColumn Header="장비명" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}"
                                                       VerticalAlignment="Center" Padding="4,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Name, Mode=TwoWay,
                                                             UpdateSourceTrigger=PropertyChanged}"
                                                     Padding="4,2"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <!-- 규격: 편집 가능 -->
                                <DataGridTemplateColumn Header="규격" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Spec}"
                                                       VerticalAlignment="Center" Padding="4,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Spec, Mode=TwoWay,
                                                             UpdateSourceTrigger=PropertyChanged}"
                                                     Padding="4,2"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <!-- 전일: 편집 가능 -->
                                <DataGridTemplateColumn Header="전일(대) ✏" Width="85">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding PrevDayCount}"
                                                       Style="{StaticResource ROCell}"
                                                       Foreground="#2D3748"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding PrevDayCount, Mode=TwoWay,
                                                             UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource EditCell}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <!-- 금일: 편집 가능 -->
                                <DataGridTemplateColumn Header="금일(대) ✏" Width="85">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TodayCount}"
                                                       TextAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding TodayCount, Mode=TwoWay,
                                                             UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource EditCell}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <!-- 누계: 자동 계산, 읽기 전용 -->
                                <DataGridTemplateColumn Header="누계(대)" Width="75">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TotalCount}"
                                                       Style="{StaticResource ROCell}"
                                                       FontWeight="SemiBold"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- 삭제 버튼 -->
                                <DataGridTemplateColumn Header="" Width="30">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="×"
                                                    Command="{Binding RemoveCommand}"
                                                    Style="{StaticResource DelBtn}"
                                                    ToolTip="행 삭제"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- 장비 추가 버튼 -->
                        <Button Content="+ 장비 추가"
                                Command="{Binding AddEquipmentCommand}"
                                HorizontalAlignment="Left" Margin="0,6,0,0"
                                Style="{StaticResource AddBtn}"/>
                    </StackPanel>
                </GroupBox>

                <!-- ══════════════ 인원 투입현황 ══════════════ -->
                <GroupBox Header="인원 투입현황"
                          Visibility="{Binding UsesPersonnel, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                        <DataGrid ItemsSource="{Binding Personnel}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserResizeRows="False" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#EDF2F7"
                                  RowHeight="30" SelectionMode="Single"
                                  BorderBrush="#CBD5E0" BorderThickness="1">
                            <DataGrid.Columns>
                                <!-- 직종: 편집 가능 -->
                                <DataGridTemplateColumn Header="직종" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Role}"
                                                       VerticalAlignment="Center" Padding="4,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Role, Mode=TwoWay,
                                                             UpdateSourceTrigger=PropertyChanged}"
                                                     Padding="4,2"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <!-- 전일누계: 편집 가능 -->
                                <DataGridTemplateColumn Header="전일누계(명) ✏" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding PrevCumulativeCount}"
                                                       Style="{StaticResource ROCell}"
                                                       Foreground="#2D3748"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding PrevCumulativeCount, Mode=TwoWay,
                                                             UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource EditCell}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <!-- 금일: 편집 가능 -->
                                <DataGridTemplateColumn Header="금일(명) ✏" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TodayCount}"
                                                       TextAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding TodayCount, Mode=TwoWay,
                                                             UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource EditCell}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <!-- 총누계: 자동 계산 -->
                                <DataGridTemplateColumn Header="총누계(명)" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TotalCumulativeCount}"
                                                       Style="{StaticResource ROCell}"
                                                       FontWeight="SemiBold"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- 삭제 -->
                                <DataGridTemplateColumn Header="" Width="30">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="×"
                                                    Command="{Binding RemoveCommand}"
                                                    Style="{StaticResource DelBtn}"
                                                    ToolTip="행 삭제"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Button Content="+ 직종 추가"
                                Command="{Binding AddPersonnelCommand}"
                                HorizontalAlignment="Left" Margin="0,6,0,0"
                                Style="{StaticResource AddBtn}"/>
                    </StackPanel>
                </GroupBox>

                <!-- ══════════════ 수장재팀 ══════════════ -->
                <GroupBox Header="수장재팀 인원 (별도)"
                          Visibility="{Binding UsesSujangjae, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                        <DataGrid ItemsSource="{Binding SujangjaePersonnel}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserResizeRows="False" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#EDF2F7"
                                  RowHeight="30" SelectionMode="Single"
                                  BorderBrush="#CBD5E0" BorderThickness="1">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="직종" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Role}"
                                                       VerticalAlignment="Center" Padding="4,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Role, Mode=TwoWay,
                                                             UpdateSourceTrigger=PropertyChanged}"
                                                     Padding="4,2"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="전일누계(명) ✏" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding PrevCumulativeCount}"
                                                       Style="{StaticResource ROCell}"
                                                       Foreground="#2D3748"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding PrevCumulativeCount, Mode=TwoWay,
                                                             UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource EditCell}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="금일(명) ✏" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TodayCount}"
                                                       TextAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding TodayCount, Mode=TwoWay,
                                                             UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource EditCell}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="총누계(명)" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TotalCumulativeCount}"
                                                       Style="{StaticResource ROCell}"
                                                       FontWeight="SemiBold"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="" Width="30">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="×"
                                                    Command="{Binding RemoveCommand}"
                                                    Style="{StaticResource DelBtn}"
                                                    ToolTip="행 삭제"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Button Content="+ 직종 추가"
                                Command="{Binding AddSujangjaeCommand}"
                                HorizontalAlignment="Left" Margin="0,6,0,0"
                                Style="{StaticResource AddBtn}"/>
                    </StackPanel>
                </GroupBox>
                </StackPanel>

                <!-- ══════════════ 단계: 사진 · 측정값 ══════════════ -->
                <StackPanel Visibility="{Binding ShowPhotosStep, Converter={StaticResource BoolVis}}">

                <!-- 문서별 입력 (사진·측정값·위치, 시트마다). 체크한 문서만 -->
                <ItemsControl ItemsSource="{Binding DocInputCards}"
                              Visibility="{Binding HasVisibleDocInputs, Converter={StaticResource BoolVis}}">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolVis}}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DocInputCardViewModel}">
                            <GroupBox>
                                <GroupBox.Header>
                                    <TextBlock Text="{Binding Name, StringFormat='📋 {0}'}" FontWeight="SemiBold"/>
                                </GroupBox.Header>
                                <StackPanel>
                                    <!-- 사진 폴더 불러오기 -->
                                    <DockPanel Margin="0,0,0,8"
                                               Visibility="{Binding HasPhotos, Converter={StaticResource BoolVis}}">
                                        <Button DockPanel.Dock="Left" Content="{Binding ImportButtonText}"
                                                Command="{Binding ImportPhotosCommand}"
                                                Padding="10,4" Background="#2B6CB0" Foreground="White"
                                                BorderThickness="0" Cursor="Hand"/>
                                        <Button DockPanel.Dock="Left" Content="폴더 바꾸기" Margin="6,0,0,0"
                                                Command="{Binding ChangeFolderCommand}"
                                                Padding="8,4" Background="#EDF2F7" BorderBrush="#CBD5E0" Cursor="Hand"/>
                                        <TextBlock Text="{Binding PhotoFolderText}" Foreground="#A0AEC0" FontSize="11"
                                                   VerticalAlignment="Center" Margin="10,0,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>

                                    <!-- 시트별 탭 -->
                                    <TabControl ItemsSource="{Binding Sheets}" SelectedItem="{Binding SelectedSheet}"
                                                BorderBrush="#CBD5E0">
                                        <TabControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Header}" Padding="6,2"/>
                                            </DataTemplate>
                                        </TabControl.ItemTemplate>
                                        <TabControl.ContentTemplate>
                                            <DataTemplate>
                                                <ItemsControl ItemsSource="{Binding Items}" Margin="4,8,4,4">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:FieldInputViewModel}">
                                                            <Border Width="190" Margin="0,0,10,10" Padding="8"
                                                                    BorderBrush="#E2E8F0" BorderThickness="1"
                                                                    CornerRadius="6" Background="White">
                                                                <StackPanel>
                                                                    <!-- 제목 + 시각 -->
                                                                    <DockPanel Margin="0,0,0,6">
                                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}"
                                                                                   Foreground="#718096" FontSize="11"/>
                                                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold"
                                                                                   Foreground="#2D3748" TextTrimming="CharacterEllipsis"/>
                                                                    </DockPanel>

                                                                    <!-- 사진 (클릭 또는 끌어다 놓기) -->
                                                                    <Grid Visibility="{Binding IsPhoto, Converter={StaticResource BoolVis}}"
                                                                          Margin="0,0,0,6">
                                                                        <Button Command="{Binding BrowseCommand}" Cursor="Hand"
                                                                                AllowDrop="True" Drop="DocPhoto_Drop"
                                                                                DragOver="PhotoSlot_DragOver">
                                                                            <Button.Template>
                                                                                <ControlTemplate TargetType="Button">
                                                                                    <Border Height="120" Background="#F7FAFC" CornerRadius="4"
                                                                                            BorderBrush="#CBD5E0" BorderThickness="1">
                                                                                        <ContentPresenter/>
                                                                                    </Border>
                                                                                </ControlTemplate>
                                                                            </Button.Template>
                                                                            <Grid>
                                                                                <TextBlock Text="🖼  클릭 또는 끌어다 놓기"
                                                                                           Foreground="#A0AEC0" FontSize="11"
                                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                                                            </Grid>
                                                                        </Button>
                                                                        <Button Content="✕" Command="{Binding ClearCommand}"
                                                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                                Margin="0,4,4,0" Width="20" Height="20" FontSize="10"
                                                                                Background="#FED7D7" Foreground="#C53030" BorderThickness="0"
                                                                                Visibility="{Binding HasPhoto, Converter={StaticResource BoolVis}}"/>
                                                                        <TextBlock Text="{Binding PhotoInfo}" FontSize="10" Foreground="White"
                                                                                   Background="#80000000" Padding="4,1"
                                                                                   HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                                                   Margin="4,0,0,4"
                                                                                   Visibility="{Binding HasPhoto, Converter={StaticResource BoolVis}}"/>
                                                                    </Grid>

                                                                    <!-- 값 입력 (+ 단위, 사진에서 읽기) -->
                                                                    <DockPanel Visibility="{Binding HasValue, Converter={StaticResource BoolVis}}">
                                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Suffix}"
                                                                                   Foreground="#718096" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                                                 Padding="4,3" FontSize="13"/>
                                                                    </DockPanel>
                                                                    <Button Content="{Binding ReadButtonText}" Command="{Binding ReadValueCommand}"
                                                                            Margin="0,4,0,0" Padding="4,2" FontSize="11"
                                                                            Background="#EDF2F7" BorderBrush="#CBD5E0" Cursor="Hand"
                                                                            ToolTip="사진 속 측정기 숫자를 AI로 읽어 칸에 채웁니다 (사진 1장 전송). 확인 후 생성하세요.">
                                                                        <Button.Style>
                                                                            <Style TargetType="Button">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <MultiDataTrigger>
                                                                                        <MultiDataTrigger.Conditions>
                                                                                            <Condition Binding="{Binding HasPhoto}" Value="True"/>
                                                                                            <Condition Binding="{Binding HasValue}" Value="True"/>
                                                                                        </MultiDataTrigger.Conditions>
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </MultiDataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Button.Style>
                                                                    </Button>

                                                                    <!-- 위치 선택 -->
                                                                    <ComboBox ItemsSource="{Binding PresetNames}"
                                                                              SelectedItem="{Binding SelectedPreset}"
                                                                              Visibility="{Binding IsShape, Converter={StaticResource BoolVis}}"
                                                                              ToolTip="설정에서 저장해 둔 위치 중 고릅니다. 고르지 않으면 서식 위치 그대로."/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </DataTemplate>
                                        </TabControl.ContentTemplate>
                                    </TabControl>
                                </StackPanel>
                            </GroupBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ══════════════ 사진대지 ══════════════ -->
                <GroupBox Header="📷 사진대지 사진"
                          Visibility="{Binding HasVisiblePhotoSlots,
                                       Converter={StaticResource BoolVis}}">
                    <StackPanel>
                        <TextBlock Foreground="#718096" FontSize="11" Margin="0,0,0,8"
                                   Text="이미지 파일을 슬롯에 드래그하거나 클릭해서 선택하세요."/>
                        <!-- 문서마다 묶어서 보여 준다 (체크한 문서만) -->
                        <ItemsControl ItemsSource="{Binding PhotoSlotGroups}">
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolVis}}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="{Binding Header}" FontWeight="SemiBold" Foreground="#2B6CB0" Margin="2,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding Slots}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PhotoSlotViewModel}">
                                    <Border Width="160" Height="130"
                                            Margin="0,0,10,10"
                                            BorderBrush="#CBD5E0" BorderThickness="1"
                                            CornerRadius="4" Background="#F7FAFC"
                                            AllowDrop="True"
                                            Drop="PhotoSlot_Drop"
                                            DragOver="PhotoSlot_DragOver"
                                            Cursor="Hand">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#F7FAFC"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasPhoto}" Value="True">
                                                        <Setter Property="Background" Value="#EBF8FF"/>
                                                        <Setter Property="BorderBrush" Value="#4299E1"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Button Command="{Binding BrowseCommand}"
                                                    Background="Transparent" BorderThickness="0"
                                                    HorizontalContentAlignment="Stretch"
                                                    VerticalContentAlignment="Stretch" Padding="0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <ContentPresenter/>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <Grid>
                                                    <StackPanel VerticalAlignment="Center"
                                                                HorizontalAlignment="Center"
                                                                Visibility="{Binding PlaceholderVisible,
                                                                             Converter={StaticResource BoolVis}}">
                                                        <TextBlock Text="🖼" FontSize="28"
                                                                   HorizontalAlignment="Center"/>
                                                        <TextBlock Text="클릭 또는 드래그"
                                                                   Foreground="#A0AEC0" FontSize="11"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                    <Image Source="{Binding Thumbnail}"
                                                           Stretch="UniformToFill"
                                                           Width="160" Height="105"
                                                           VerticalAlignment="Top">
                                                        <Image.Style>
                                                            <Style TargetType="Image">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasPhoto}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Image.Style>
                                                    </Image>
                                                </Grid>
                                            </Button>
                                            <Grid VerticalAlignment="Bottom" Height="25"
                                                  Background="#00000018">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Label}"
                                                           Foreground="#2D3748" FontSize="11"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           Margin="6,0"/>
                                                <Button Grid.Column="1"
                                                        Command="{Binding ClearCommand}"
                                                        Content="✕" Width="22" Height="22"
                                                        FontSize="10"
                                                        Background="#FEB2B2" Foreground="#C53030"
                                                        BorderThickness="0" Margin="0,0,2,0"
                                                        VerticalAlignment="Center" Cursor="Hand">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="{TemplateBinding Background}"
                                                                                CornerRadius="11" Padding="2">
                                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                                              VerticalAlignment="Center"/>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasPhoto}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </GroupBox>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
        </Grid>

        <!-- ─── 하단 합계 + 생성 버튼 ───────────────────────────── -->
        <Border Grid.Row="2" Background="#EBF8FF" BorderBrush="#BEE3F8"
                BorderThickness="0,1,0,0" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 이전 / 다음 단계 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Button Content="◀ 이전" Command="{Binding PrevStepCommand}" Style="{StaticResource AddBtn}"
                            Padding="12,5" FontSize="13"/>
                    <Button Content="다음 ▶" Command="{Binding NextStepCommand}" Style="{StaticResource AddBtn}"
                            Padding="12,5" FontSize="13" Margin="6,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Foreground="#2C5282" FontSize="12" Text="장비 금일: "/>
                    <TextBlock Foreground="#2C5282" FontSize="12" FontWeight="Bold"
                               Text="{Binding TotalTodayEquipment}"/>
                    <TextBlock Foreground="#2C5282" FontSize="12" Text="대　　공사 인원: "/>
                    <TextBlock Foreground="#2C5282" FontSize="12" FontWeight="Bold"
                               Text="{Binding TotalTodayPersonnel}"/>
                    <TextBlock Foreground="#2C5282" FontSize="12" Text="명　　TBM 합계: "/>
                    <TextBlock Foreground="#2C5282" FontSize="12" FontWeight="Bold"
                               Text="{Binding TotalTodayPersonnelWithSujangjae}"/>
                    <TextBlock Foreground="#2C5282" FontSize="12" Text="명"/>
                </StackPanel>

                <Button Grid.Column="2"
                        Command="{Binding GenerateCommand}"
                        Content="📄  파일 생성"
                        Width="120" Height="34"
                        Background="#2B6CB0" Foreground="White"
                        FontSize="13" FontWeight="SemiBold"
                        BorderThickness="0" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background"  Value="#2B6CB0"/>
                            <Setter Property="Foreground"  Value="White"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="4" Padding="12,0">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#2C5282"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="#1A365D"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
