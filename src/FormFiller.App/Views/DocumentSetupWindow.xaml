<Window x:Class="FormFiller.App.Views.DocumentSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FormFiller.App.ViewModels.Settings"
        Title="{Binding WindowTitle}" Width="1280" Height="800"
        MinWidth="1000" MinHeight="620"
        FontFamily="Malgun Gothic" FontSize="13"
        WindowStartupLocation="CenterOwner"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">

    <Window.DataContext>
        <vm:DocumentSetupViewModel />
    </Window.DataContext>

    <!--
        [화면 구성]
        왼쪽: 서식 파일 + Excel 미리보기 (Excel 창이 그 자리에 겹쳐 보인다)
        오른쪽: 기본 정보 → 적용할 시트 → 항목 카드 목록 → 저장
        ※ Excel 창은 WPF 화면 "위"에 겹쳐 있으므로, 왼쪽 미리보기 영역 위로 펼쳐지는
          콤보박스·팝업은 두지 않는다 (가려진다). 시트 전환은 Excel 아래쪽 시트 탭으로 한다.
    -->

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#4A5568"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#2D3748"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,14,0,8"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="5,4"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- 납작한 버튼 (색은 Background/Foreground 로 지정) -->
        <Style x:Key="FlatBtn" TargetType="Button">
            <Setter Property="Background" Value="#EDF2F7"/>
            <Setter Property="Foreground" Value="#2D3748"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource FlatBtn}">
            <Setter Property="Background" Value="#2B6CB0"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="SmallBtn" TargetType="Button" BasedOn="{StaticResource FlatBtn}">
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,4,4"/>
        </Style>

        <!-- 시트 선택 칩 -->
        <Style x:Key="ChipToggle" TargetType="ToggleButton">
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="b" CornerRadius="12" Padding="10,3" Background="#EDF2F7"
                                BorderBrush="#CBD5E0" BorderThickness="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#2B6CB0"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#2B6CB0"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── 항목 카드 ── -->
        <DataTemplate DataType="{x:Type vm:SetupItemViewModel}">
            <Border Margin="0,0,0,8" Padding="10,8" CornerRadius="6" Background="White"
                    BorderBrush="#E2E8F0" BorderThickness="1" Cursor="Hand"
                    ToolTip="누르면 왼쪽 Excel 에서 위치를 보여 줍니다">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding RevealCommand}"/>
                </Border.InputBindings>
                <StackPanel>
                    <!-- 제목 줄: 아이콘 · 이름 · 상태 · 삭제 -->
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="✕" Command="{Binding RemoveCommand}"
                                Style="{StaticResource FlatBtn}" Padding="6,1" Background="Transparent"
                                Foreground="#A0AEC0" ToolTip="항목 삭제"/>
                        <TextBlock DockPanel.Dock="Right" Text="✓" Foreground="#38A169" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="6,0"
                                   Visibility="{Binding IsComplete, Converter={StaticResource BoolVis}}"/>
                        <TextBlock DockPanel.Dock="Right" Text="지정 필요" Foreground="#DD6B20" FontSize="11"
                                   VerticalAlignment="Center" Margin="6,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Icon}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0"
                                 Background="Transparent" FontWeight="SemiBold" Padding="0" ToolTip="이름 바꾸기"/>
                    </DockPanel>

                    <!-- 종류 · 지정 위치 -->
                    <TextBlock Margin="22,2,0,0" FontSize="11" Foreground="#718096" TextWrapping="Wrap">
                        <Run Text="{Binding TypeLabel, Mode=OneWay}"/>
                        <Run Text="  "/>
                        <Run Text="{Binding Summary, Mode=OneWay}" Foreground="#2B6CB0"/>
                    </TextBlock>

                    <!-- Excel: 다시 지정 / 측정값 칸 / 표의 열 -->
                    <WrapPanel Margin="22,6,0,0" Visibility="{Binding IsExcel, Converter={StaticResource BoolVis}}">
                        <Button Content="📍 Excel 에서 지정" Command="{Binding PickCommand}" Style="{StaticResource SmallBtn}"/>
                        <Button Content="측정값 칸" Command="{Binding PickValueCommand}" Style="{StaticResource SmallBtn}"
                                Visibility="{Binding IsPhoto, Converter={StaticResource BoolVis}}"/>
                        <ItemsControl ItemsSource="{Binding ColumnButtons}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Text}" Style="{StaticResource SmallBtn}"
                                            CommandParameter="{Binding Key}"
                                            Command="{Binding DataContext.PickColumnCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </WrapPanel>

                    <!-- 표·명단: 머리글에서 자동으로 찾은 열 -->
                    <TextBlock Text="{Binding AutoNote}" Margin="22,4,0,0" FontSize="11" Foreground="#276749" TextWrapping="Wrap"
                               Visibility="{Binding HasAutoNote, Converter={StaticResource BoolVis}}"/>

                    <!-- 단위 · 시각 -->
                    <WrapPanel Margin="22,4,0,0" Visibility="{Binding HasSuffix, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="단위" Style="{StaticResource LabelStyle}" FontSize="11"/>
                        <TextBox Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged}" Width="50" FontSize="11"
                                 Padding="3,1" ToolTip="입력값 뒤에 자동으로 붙습니다 (예: dB)"/>
                        <StackPanel Orientation="Horizontal" Margin="12,0,0,0"
                                    Visibility="{Binding IsPhoto, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="찍는 시각" Style="{StaticResource LabelStyle}" FontSize="11"/>
                            <TextBox Text="{Binding Time, UpdateSourceTrigger=LostFocus}" Width="56" FontSize="11"
                                     Padding="3,1" ToolTip="예: 10:00 — 사진 폴더에서 촬영 시각이 가까운 사진을 자동으로 넣습니다"/>
                        </StackPanel>
                    </WrapPanel>

                    <!-- ── 블록 규칙 (종류마다 다른 칸) ── -->
                    <StackPanel Margin="22,6,0,0" Visibility="{Binding IsBlock, Converter={StaticResource BoolVis}}">
                        <!-- 값 이름: 같은 이름이면 다른 문서와 같은 입력 -->
                        <DockPanel Margin="0,0,0,4" Visibility="{Binding HasKey, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="값 이름" Style="{StaticResource LabelStyle}" FontSize="11" Width="62"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding KeyHint}" FontSize="10" Foreground="#A0AEC0"
                                       VerticalAlignment="Center" Margin="6,0,0,0"/>
                            <TextBox Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="3,1"
                                     ToolTip="다른 문서에 같은 이름의 항목이 있으면 메인 화면에서 한 번만 입력합니다 (예: 날씨)"/>
                        </DockPanel>

                        <!-- 값: 어디서 -->
                        <StackPanel Visibility="{Binding IsValue, Converter={StaticResource BoolVis}}">
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="값은" Style="{StaticResource LabelStyle}" FontSize="11" Width="62"/>
                                <ComboBox ItemsSource="{Binding ValueSources}" SelectedItem="{Binding ValueSource}" FontSize="11"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,4" Visibility="{Binding IsFixedValue, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="고정값" Style="{StaticResource LabelStyle}" FontSize="11" Width="62"/>
                                <TextBox Text="{Binding FixedValue, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="3,1"
                                         ToolTip="매일 이 값을 씁니다 (예: 100)"/>
                            </DockPanel>
                        </StackPanel>

                        <!-- 날짜: 형식 + 미리보기 -->
                        <DockPanel Margin="0,0,0,4" Visibility="{Binding IsDate, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="형식" Style="{StaticResource LabelStyle}" FontSize="11" Width="62"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding DatePreview}" FontSize="11" Foreground="#2B6CB0"
                                       VerticalAlignment="Center" Margin="6,0,0,0"/>
                            <!-- IsEditable: 목록에 없는 형식도 직접 적을 수 있다 ({yyyy} {yy} {MM} {M} {dd} {d} {요일} {요}) -->
                            <ComboBox ItemsSource="{Binding DateFormats}" Text="{Binding DateFormat, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True" FontSize="11"
                                      ToolTip="{}{yyyy}=2026 {yy}=26 {MM}=11 {M}=3 {dd}=05 {d}=5 {요일}=수요일 {요}=수"/>
                        </DockPanel>

                        <!-- 여러 줄: 앞 글자, 처음 값 -->
                        <StackPanel Visibility="{Binding IsLines, Converter={StaticResource BoolVis}}">
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="앞 글자" Style="{StaticResource LabelStyle}" FontSize="11" Width="62"/>
                                <TextBox Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}" Width="50" FontSize="11" Padding="3,1"
                                         HorizontalAlignment="Left" ToolTip="줄마다 앞에 붙일 글자 (예: '- '). 없으면 비워 두세요"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="처음 값" Style="{StaticResource LabelStyle}" FontSize="11" Width="62"/>
                                <ComboBox ItemsSource="{Binding StartFromChoices}" SelectedValuePath="Value"
                                          SelectedValue="{Binding StartFrom}" FontSize="11"/>
                            </DockPanel>
                        </StackPanel>

                        <!-- 숫자 누계: 칸 3개 -->
                        <WrapPanel Margin="0,0,0,4" Visibility="{Binding IsCounter, Converter={StaticResource BoolVis}}">
                            <Button Content="누계 칸" Command="{Binding PickTotalCommand}" Style="{StaticResource SmallBtn}"/>
                            <Button Content="전일 칸 (선택)" Command="{Binding PickPrevCommand}" Style="{StaticResource SmallBtn}"/>
                        </WrapPanel>

                        <!-- 식: 식 상자 + 칸·입력 넣기 -->
                        <StackPanel Margin="0,0,0,4" Visibility="{Binding IsFormula, Converter={StaticResource BoolVis}}">
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="식" Style="{StaticResource LabelStyle}" FontSize="11" Width="62"/>
                                <TextBox Text="{Binding Formula, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Padding="3,2"
                                         FontFamily="Consolas, Malgun Gothic"
                                         ToolTip="예) [어제 H20] + [입력 장비]   /   &quot;장비 &quot; &amp; [입력 장비] &amp; &quot;대&quot;"/>
                            </DockPanel>
                            <TextBlock Text="{Binding FormulaError}" FontSize="11" Foreground="#E53E3E" TextWrapping="Wrap" Margin="62,0,0,4"
                                       Visibility="{Binding HasFormulaError, Converter={StaticResource BoolVis}}"/>
                            <WrapPanel Margin="62,0,0,0">
                                <Button Content="＋ 어제 칸" Command="{Binding InsertYesterdayCellCommand}" Style="{StaticResource SmallBtn}"
                                        ToolTip="Excel 에서 칸을 클릭하면 [어제 그 칸] 을 넣습니다"/>
                                <Button Content="＋ 오늘 칸" Command="{Binding InsertTodayCellCommand}" Style="{StaticResource SmallBtn}"
                                        ToolTip="Excel 에서 칸을 클릭하면 [그 칸] 을 넣습니다 (오늘 다른 항목을 다 쓴 뒤의 값)"/>
                                <ComboBox ItemsSource="{Binding OtherKeys}" SelectedItem="{Binding InsertInputKey}" FontSize="11"
                                          Width="120" Margin="0,0,4,4" ToolTip="고르면 [입력 이름] 을 식에 넣습니다"/>
                            </WrapPanel>
                            <TextBlock FontSize="10" Foreground="#A0AEC0" TextWrapping="Wrap" Margin="62,2,0,0"
                                       Text="곱하기 *, 나누기 /, 글자는 &quot;…&quot;, 이어붙이기는 &amp;. 빈 칸은 0. ▾ 에서 입력 이름을 고르면 식에 들어갑니다."/>
                        </StackPanel>

                        <!-- 0 일 때 표시 -->
                        <DockPanel Margin="0,0,0,4" Visibility="{Binding HasZeroOption, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="0 일 때" Style="{StaticResource LabelStyle}" FontSize="11" Width="62"/>
                            <ComboBox ItemsSource="{Binding ZeroChoices}" SelectedItem="{Binding ZeroAs}" FontSize="11" Width="100"
                                      HorizontalAlignment="Left" ToolTip="숫자가 0 이면 이렇게 씁니다"/>
                        </DockPanel>

                        <!-- 사진 구역: 칸 목록 + 칸 추가 / 1장일 때 자리 / 다시 -->
                        <StackPanel Margin="0,0,0,4" Visibility="{Binding IsPhotos, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{Binding PhotoAreasText}" FontSize="11" Foreground="#4A5568" TextWrapping="Wrap"
                                       LineHeight="17" Margin="0,0,0,4"/>
                            <WrapPanel>
                                <Button Content="＋ 사진 칸 추가" Command="{Binding AddPhotoAreaCommand}" Style="{StaticResource SmallBtn}"
                                        ToolTip="사진이 들어갈 칸들을 드래그(또는 그 자리 그림 클릭) → 설명 칸 클릭"/>
                                <Button Content="1장일 때 자리" Command="{Binding PickSinglePhotoCommand}" Style="{StaticResource SmallBtn}"
                                        ToolTip="사진이 1장인 날 넣을 자리 (예: 두 칸을 합친 자리)와 그 설명 칸"/>
                                <Button Content="칸 모두 지우기" Command="{Binding ClearPhotoAreasCommand}" Style="{StaticResource SmallBtn}"/>
                            </WrapPanel>
                            <TextBlock Text="사진은 메인 화면에서 매일 넣습니다 (그날 장수만큼 칸 1부터)." FontSize="10"
                                       Foreground="#A0AEC0" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- 표: 명단에서 세기 -->
                        <StackPanel Visibility="{Binding IsTable, Converter={StaticResource BoolVis}}">
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="금일 값" Style="{StaticResource LabelStyle}" FontSize="11" Width="62"/>
                                <ComboBox Text="{Binding RosterKey, UpdateSourceTrigger=PropertyChanged}" IsEditable="True"
                                          ItemsSource="{Binding OtherKeys}" FontSize="11"
                                          ToolTip="비우면 메인 화면에서 직접 입력. 명단 항목 이름을 적으면 그 명단에서 직종별로 셉니다"/>
                            </DockPanel>
                            <TextBlock Text="↑ 비우면 직접 입력 / 명단 이름을 적으면 직종별로 자동으로 셉니다" FontSize="10"
                                       Foreground="#A0AEC0" Margin="62,0,0,4"/>
                            <!-- 짝짓기: 표의 줄마다 셀 명단 직종을 체크 (예: 관리자 ← 소장·차장·대리) -->
                            <StackPanel Visibility="{Binding HasRosterKey, Converter={StaticResource BoolVis}}">
                                <DockPanel Margin="0,2,0,4">
                                    <Button DockPanel.Dock="Right" Content="↻ 짝짓기 표 불러오기" Command="{Binding LoadRoleMapCommand}"
                                            Style="{StaticResource SmallBtn}"/>
                                    <TextBlock Text="짝짓기 — 줄마다 셀 직종을 체크" FontSize="11" Foreground="#4A5568" VerticalAlignment="Center"/>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding RoleMapRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:RoleMapRow}">
                                            <DockPanel Margin="0,0,0,3">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding RowName}" Width="70" FontSize="11"
                                                           FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,2,4,0"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding RowName}"/>
                                                <ItemsControl ItemsSource="{Binding Jobs}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:KeyChoice}">
                                                            <CheckBox Content="{Binding Display}" IsChecked="{Binding IsChecked}"
                                                                      FontSize="11" Margin="0,1,8,1"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- 표를 못 불러왔을 때는 글자로 적는다 -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasRoleMapRows}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBox Text="{Binding RoleMapText, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="3,1"
                                             ToolTip="표의 줄 이름 = 셀 직종들. 예) 관리자 = 소장, 차장, 대리 / 장비 = 장비"/>
                                    <TextBlock Text="표의 행을 지정하면 체크 표로 바뀝니다. 예) 관리자 = 소장, 차장, 대리" FontSize="10"
                                               Foreground="#A0AEC0" Margin="0,2,0,4"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- 계산 -->
                        <StackPanel Visibility="{Binding IsCalc, Converter={StaticResource BoolVis}}">
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="계산" Style="{StaticResource LabelStyle}" FontSize="11" Width="62"/>
                                <ComboBox ItemsSource="{Binding CalcKinds}" SelectedItem="{Binding CalcKind}" FontSize="11"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="쓸 항목" Style="{StaticResource LabelStyle}" FontSize="11" Width="62" VerticalAlignment="Top"/>
                                <ItemsControl ItemsSource="{Binding SourceChoices}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:KeyChoice}">
                                            <CheckBox Content="{Binding Display}" IsChecked="{Binding IsChecked}" FontSize="11" Margin="0,1,10,1">
                                                <CheckBox.Style>
                                                    <Style TargetType="CheckBox">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                                <Setter Property="Foreground" Value="#E53E3E"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </CheckBox.Style>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                            <TextBlock Text="다른 항목을 먼저 만들면 여기에 나옵니다 (다른 문서의 항목도)." FontSize="10"
                                       Foreground="#A0AEC0" TextWrapping="Wrap" Margin="62,0,0,4"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 그림 위치: 저장된 위치 목록 + 지금 위치 저장 -->
                    <StackPanel Margin="22,6,0,0" Visibility="{Binding IsShape, Converter={StaticResource BoolVis}}">
                        <ItemsControl ItemsSource="{Binding Presets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PresetItemViewModel}">
                                    <Border Background="#EBF8FF" CornerRadius="10" Margin="0,0,6,6" Padding="8,1,2,1">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="{Binding Name}" Command="{Binding ShowCommand}"
                                                    Style="{StaticResource FlatBtn}" Background="Transparent" Padding="0,1"
                                                    Foreground="#2B6CB0" ToolTip="Excel 에서 이 위치로 옮겨 보기"/>
                                            <Button Content="✕" Command="{Binding RemoveCommand}" Style="{StaticResource FlatBtn}"
                                                    Background="Transparent" Foreground="#A0AEC0" Padding="5,0" FontSize="10"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="지금 위치 저장" Command="{Binding SavePresetCommand}"
                                    Style="{StaticResource SmallBtn}" Background="#2B6CB0" Foreground="White" Margin="6,0,0,0"/>
                            <TextBox Text="{Binding NewPresetName, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="3,1"
                                     ToolTip="위치 이름 (예: 정문 앞). 비우면 '위치 N'"/>
                        </DockPanel>
                        <TextBlock Text="Excel 에서 그림을 원하는 자리로 끌어다 놓고 [지금 위치 저장]" FontSize="10"
                                   Foreground="#A0AEC0" Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- 한글: 자리 표시 -->
                    <DockPanel Margin="22,6,0,0" Visibility="{Binding IsHwpx, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="서식의 자리" Style="{StaticResource LabelStyle}" FontSize="11"/>
                        <TextBox Text="{Binding Placeholder, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="3,1"
                                 ToolTip="한글 서식에 적어 둔 자리 글자 (예: {{날짜}})"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="420"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════ 왼쪽: 서식 파일 + 미리보기 ══════════ -->
        <Grid Grid.Column="0" Margin="12,10,8,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="파일 찾기" Command="{Binding BrowseFileCommand}"
                        Style="{StaticResource FlatBtn}" Margin="6,0,0,0"/>
                <TextBlock Text="서식 파일" Style="{StaticResource LabelStyle}"/>
                <TextBox Text="{Binding FilePath, Mode=OneWay}" IsReadOnly="True" Foreground="#4A5568"
                         ToolTip="엑셀(.xlsx) 또는 한글(.hwpx) 서식. 창에 끌어다 놓아도 됩니다."/>
            </DockPanel>

            <Border Grid.Row="1" x:Name="PreviewBorder" BorderBrush="#CBD5E0" BorderThickness="1" Background="#F7FAFC">
                <Grid>
                    <!-- 파일 없음 안내 -->
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                               Foreground="#A0AEC0" FontSize="14" LineHeight="24">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasFile}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        서식 파일을 여기에 끌어다 놓거나 [파일 찾기]를 누르세요<LineBreak/>
                        엑셀(.xlsx) · 한글(.hwpx)
                    </TextBlock>

                    <!-- 한글 안내 (한글은 미리보기 없이 자리 글자로 지정) -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsHwpx}" Value="True"/>
                                            <Condition Binding="{Binding HasFile}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="📄 한글 서식" FontSize="18" FontWeight="SemiBold" Foreground="#2D3748"
                                   HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#4A5568" LineHeight="22">
                            한글에서 서식의 채울 자리에 <Bold>{{날짜}}</Bold>, <Bold>{{날씨}}</Bold> 처럼 적어 두고
                            hwpx 로 저장하세요. 그 자리를 찾아 오른쪽 항목으로 만들어 줍니다.<LineBreak/><LineBreak/>
                            · 자리 글자는 한 번에 입력하고, 중간에 글꼴·색을 바꾸지 마세요.<LineBreak/>
                            · 서식을 고친 뒤에는 [자리 다시 찾기]를 누르세요.
                        </TextBlock>
                        <Button Content="🔍 자리 다시 찾기" Command="{Binding ScanPlaceholdersCommand}"
                                Style="{StaticResource PrimaryBtn}" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                    </StackPanel>

                    <!-- Excel 창이 이 자리에 겹쳐진다 -->
                    <ContentControl x:Name="ExcelHostControl"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════ 오른쪽: 설정 ══════════ -->
        <Grid Grid.Column="1" Background="#F7FAFC">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
            <!-- 칸 먼저 고르기: Excel 에서 칸을 고르면 "이 칸은?" -->
            <Border Background="#EBF8FF" BorderBrush="#90CDF4" BorderThickness="0,0,0,1" Padding="12,10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasCellChoices}" Value="True"/>
                                    <Condition Binding="{Binding IsPicking}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="✕" Command="{Binding CloseCellChoicesCommand}"
                                Style="{StaticResource FlatBtn}" Background="Transparent" Foreground="#718096" Padding="6,0"
                                ToolTip="닫기"/>
                        <TextBlock FontWeight="SemiBold" Foreground="#2C5282" TextWrapping="Wrap">
                            <Run Text="{Binding SelectionText, Mode=OneWay}"/><Run Text="  →  이 칸은?"/>
                        </TextBlock>
                    </DockPanel>
                    <TextBlock Text="{Binding SelectionOwner}" FontSize="11" Foreground="#C05621" TextWrapping="Wrap" Margin="0,3,0,0"
                               Visibility="{Binding HasSelectionOwner, Converter={StaticResource BoolVis}}"/>
                    <ItemsControl ItemsSource="{Binding CellChoices}" Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CellChoice}">
                                <Button Content="{Binding Display}" Command="{Binding Command}" ToolTip="{Binding Hint}"
                                        Style="{StaticResource FlatBtn}" Background="White" Foreground="#2D3748"
                                        Padding="9,5" Margin="0,0,6,6"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="고르면 아래 목록에 항목이 생기고, 남은 칸(누계 칸·표의 열 등)을 이어서 묻습니다." FontSize="10"
                               Foreground="#718096" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 고르는 중 안내 (Excel 에서 클릭하세요) -->
            <Border Background="#2B6CB0" Padding="12,10"
                    Visibility="{Binding IsPicking, Converter={StaticResource BoolVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding PickPrompt}" Foreground="White" TextWrapping="Wrap" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="확인" Command="{Binding ConfirmPickCommand}" Style="{StaticResource FlatBtn}"
                                Background="White" Foreground="#2B6CB0" Margin="0,0,6,0"
                                Visibility="{Binding PickNeedsConfirm, Converter={StaticResource BoolVis}}"/>
                        <Button Content="{Binding PickSkipText}" Command="{Binding SkipPickCommand}" Style="{StaticResource FlatBtn}"
                                Background="#4299E1" Foreground="White" Margin="0,0,6,0"
                                Visibility="{Binding PickCanSkip, Converter={StaticResource BoolVis}}"/>
                        <Button Content="취소" Command="{Binding CancelPickCommand}" Style="{StaticResource FlatBtn}"
                                Background="#4299E1" Foreground="White"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,0,14,10">
                <StackPanel>
                    <!-- 기본 정보 -->
                    <TextBlock Text="기본 정보" Style="{StaticResource SectionTitle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="78"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="문서 이름" Style="{StaticResource LabelStyle}"/>
                        <TextBox Grid.Column="1" Text="{Binding DocumentName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>

                        <TextBlock Grid.Row="1" Text="저장 이름" Style="{StaticResource LabelStyle}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding OutputPattern, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,6" ToolTip="{}{yy}=연도 2자리, {MM}=월, {dd}=일 로 바뀝니다"/>

                        <TextBlock Grid.Row="2" Text="만드는 주기" Style="{StaticResource LabelStyle}"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                            <ComboBox ItemsSource="{Binding FrequencyOptions}" SelectedItem="{Binding SelectedFrequency}"
                                      DisplayMemberPath="Label" Width="120"/>
                            <TextBox Text="{Binding FrequencyDays}" Width="44" Margin="8,0,4,0"
                                     Visibility="{Binding IsCustomFrequency, Converter={StaticResource BoolVis}}"/>
                            <TextBlock Text="일마다" VerticalAlignment="Center" Foreground="#4A5568"
                                       Visibility="{Binding IsCustomFrequency, Converter={StaticResource BoolVis}}"/>
                            <!-- 매주: 요일 -->
                            <ComboBox ItemsSource="{Binding WeekdayOptions}" SelectedItem="{Binding SelectedWeekday}"
                                      DisplayMemberPath="Label" Width="80" Margin="8,0,0,0"
                                      Visibility="{Binding IsWeeklyFrequency, Converter={StaticResource BoolVis}}"/>
                            <CheckBox Content="그 요일 날짜로" Margin="8,0,0,0" VerticalAlignment="Center"
                                      IsChecked="{Binding UseWeeklyDayDate}" Foreground="#4A5568"
                                      ToolTip="켜면 수요일에 만들어도 파일 날짜는 그 주 정한 요일. 끄면 만드는 날 날짜."
                                      Visibility="{Binding IsWeeklyFrequency, Converter={StaticResource BoolVis}}"/>
                        </StackPanel>

                        <CheckBox Grid.Row="3" Grid.Column="1" Content="인원에 수장재팀 포함"
                                  IsChecked="{Binding IncludesSujangjae}" Foreground="#4A5568"
                                  Visibility="{Binding ShowSujangjae, Converter={StaticResource BoolVis}}"/>
                    </Grid>

                    <!-- 적용할 시트 -->
                    <StackPanel Visibility="{Binding IsExcel, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="적용할 시트" Style="{StaticResource SectionTitle}"/>
                        <ItemsControl ItemsSource="{Binding SheetChoices}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SheetChoice}">
                                    <ToggleButton Content="{Binding Name}" IsChecked="{Binding IsChecked}"
                                                  Style="{StaticResource ChipToggle}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock FontSize="11" Foreground="#A0AEC0" TextWrapping="Wrap">
                            칸 배치가 같은 시트를 모두 고르면, 한 시트에서 지정한 대로 전부 채웁니다.
                            매일 입력(사진·측정값·위치)은 시트마다 따로 받습니다.
                        </TextBlock>
                    </StackPanel>

                    <!-- 항목 -->
                    <TextBlock Text="채울 항목" Style="{StaticResource SectionTitle}"/>
                    <Border Background="#FFFAF0" BorderBrush="#F6AD55" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,8"
                            Visibility="{Binding HasLegacyItems, Converter={StaticResource BoolVis}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="블록 방식으로 바꾸기" Command="{Binding ConvertToBlocksCommand}"
                                    Style="{StaticResource SmallBtn}" Margin="6,0,0,0"/>
                            <TextBlock Text="예전 방식 항목이 있습니다. 바꾸면 같은 칸·같은 결과로, 규칙을 직접 고를 수 있게 됩니다."
                                       FontSize="11" Foreground="#7B341E" TextWrapping="Wrap"/>
                        </DockPanel>
                    </Border>
                    <TextBlock FontSize="12" Foreground="#A0AEC0" TextWrapping="Wrap" Margin="0,0,0,8"
                               Visibility="{Binding HasNoItems, Converter={StaticResource BoolVis}}">
                        왼쪽 Excel 에서 채울 칸을 클릭하세요 (여러 칸은 드래그, 사진은 그림 클릭).
                        위쪽에 "이 칸은?" 선택지가 뜹니다. 칸 없이 계산에만 쓰는 입력은 [+ 항목 추가].
                    </TextBlock>
                    <ItemsControl x:Name="ItemsList" ItemsSource="{Binding Items}"/>

                    <!-- 항목 추가 패널 -->
                    <Border Background="White" BorderBrush="#90CDF4" BorderThickness="1" CornerRadius="6"
                            Padding="10" Margin="0,4,0,0"
                            Visibility="{Binding ShowAddPanel, Converter={StaticResource BoolVis}}">
                        <StackPanel>
                            <TextBlock Text="종류" Foreground="#4A5568" Margin="0,0,0,4"/>
                            <ListBox ItemsSource="{Binding ItemTypes}" SelectedItem="{Binding NewItemType}"
                                     DisplayMemberPath="Display" MaxHeight="280" BorderBrush="#E2E8F0"/>
                            <TextBlock Text="{Binding NewItemType.Hint}" FontSize="11" Foreground="#718096" TextWrapping="Wrap"
                                       Margin="0,6,0,0" Visibility="{Binding NewItemType.HasHint, Converter={StaticResource BoolVis}}"/>
                            <TextBlock Text="이름" Foreground="#4A5568" Margin="0,8,0,4"/>
                            <TextBox Text="{Binding NewItemLabel, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="예: 10시 측정, 장비 위치"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                        Visibility="{Binding NewItemType.AsksSuffix, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="단위" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding NewItemSuffix, UpdateSourceTrigger=PropertyChanged}" Width="60"
                                         ToolTip="값 뒤에 자동으로 붙음 (예: dB). 없으면 비워 두세요"/>
                                <StackPanel Orientation="Horizontal" Margin="14,0,0,0"
                                            Visibility="{Binding NewItemType.AsksTime, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="찍는 시각" Style="{StaticResource LabelStyle}"/>
                                    <TextBox Text="{Binding NewItemTime, UpdateSourceTrigger=PropertyChanged}" Width="60"
                                             ToolTip="예: 10:00 (사진 자동 배치용, 없으면 비워 두세요)"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                <Button Content="취소" Command="{Binding CancelAddItemCommand}" Style="{StaticResource FlatBtn}" Margin="0,0,6,0"/>
                                <Button Content="추가하고 Excel 에서 지정" Command="{Binding ConfirmAddItemCommand}" Style="{StaticResource PrimaryBtn}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Button Content="+ 항목 추가" Command="{Binding AddItemCommand}" Style="{StaticResource FlatBtn}"
                            Background="#C6F6D5" Foreground="#22543D" HorizontalAlignment="Left" Margin="0,6,0,0"
                            FontWeight="SemiBold"/>

                    <!-- 사진대지 슬롯 (예전 방식) -->
                    <Expander Header="사진대지 슬롯 (시트의 그림을 순서대로 교체하는 방식)" Margin="0,18,0,0"
                              Foreground="#718096" Visibility="{Binding ShowLegacyPhotoSlots, Converter={StaticResource BoolVis}}">
                        <StackPanel Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="사진 시트" Style="{StaticResource LabelStyle}"/>
                                <ComboBox ItemsSource="{Binding PhotoSheetOptions}" SelectedItem="{Binding SelectedPhotoSheet}" Width="200"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding PhotoSlotRows}" Margin="0,8,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#CBD5E0" BorderThickness="1" CornerRadius="4" Margin="0,0,8,8" Padding="6" Background="White">
                                            <StackPanel Width="110">
                                                <Image Source="{Binding Thumbnail}" Height="66" Stretch="Uniform"/>
                                                <TextBlock Text="{Binding SlotIndex, StringFormat='슬롯 {0}'}" FontSize="10" Foreground="#718096" Margin="0,4,0,2"/>
                                                <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="3,1"
                                                         ToolTip="메인 화면에 표시할 이름"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Padding="14,10" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Background="White">
                <Button Content="💾  저장" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryBtn}"
                        Height="38" FontSize="14" FontWeight="SemiBold"/>
            </Border>
        </Grid>
    </Grid>
</Window>
