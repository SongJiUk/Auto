<Window x:Class="FormFiller.App.Views.DocumentSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FormFiller.App.ViewModels.Settings"
        Title="새 문서 설정" Width="1100" Height="720"
        MinWidth="900" MinHeight="600"
        FontFamily="Malgun Gothic" FontSize="13"
        WindowStartupLocation="CenterOwner"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <!-- ViewModel 을 DataContext 로 설정한다. -->
    <Window.DataContext>
        <vm:DocumentSetupViewModel />
    </Window.DataContext>

    <Window.Resources>

        <!-- bool → Visibility 변환기 (True=Visible, False=Collapsed) -->
        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <!-- 레이블 스타일 -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground"        Value="#4A5568"/>
            <Setter Property="Margin"            Value="0,0,6,0"/>
        </Style>

        <!-- TextBox 기본 스타일 -->
        <Style TargetType="TextBox">
            <Setter Property="Padding"         Value="4,3"/>
            <Setter Property="BorderBrush"     Value="#CBD5E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- 찾아보기 버튼 스타일 -->
        <Style x:Key="BrowseButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="#EBF8FF"/>
            <Setter Property="Foreground"      Value="#2B6CB0"/>
            <Setter Property="BorderBrush"     Value="#BEE3F8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="10,4"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#BEE3F8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 저장 버튼 스타일 -->
        <Style x:Key="SaveButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="#2B6CB0"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="16,6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2C5282"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1A365D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 피커 시작 버튼 스타일 (작은 파란 버튼) -->
        <Style x:Key="PickerButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="#EBF8FF"/>
            <Setter Property="Foreground"      Value="#2B6CB0"/>
            <Setter Property="BorderBrush"     Value="#90CDF4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="6,2"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#BEE3F8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 테이블 설정 버튼 스타일 (회색) -->
        <Style x:Key="TableSetupButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="#EDF2F7"/>
            <Setter Property="Foreground"      Value="#4A5568"/>
            <Setter Property="BorderBrush"     Value="#CBD5E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="8,2"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#CBD5E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 헤더 -->
            <RowDefinition Height="*"/>     <!-- 본문 -->
        </Grid.RowDefinitions>

        <!-- ─── 헤더 ──────────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="#2B6CB0" Padding="16,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📄 새 문서 설정" Foreground="White"
                           FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Foreground="#BEE3F8" FontSize="12" Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Text="엑셀 파일을 업로드하고 셀을 클릭해 필드를 지정하세요"/>
            </StackPanel>
        </Border>

        <!-- ─── 본문: 좌(60%) + 우(40%) ──────────────────────────── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>  <!-- 좌측: 엑셀 미리보기 -->
                <ColumnDefinition Width="2*"/>  <!-- 우측: 필드 지정 -->
            </Grid.ColumnDefinitions>

            <!-- ══════════════════════════════════════════════════════
                 좌측 패널: 파일 선택 + 시트 선택 + 엑셀 미리보기
                 ══════════════════════════════════════════════════════ -->
            <Border Grid.Column="0" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0"
                    Background="#FAFAFA">
                <Grid Margin="12,10,12,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- 파일 선택 -->
                        <RowDefinition Height="Auto"/>  <!-- 시트 선택 -->
                        <RowDefinition Height="*"/>     <!-- 미리보기 -->
                        <RowDefinition Height="Auto"/>  <!-- 선택된 셀 정보 -->
                    </Grid.RowDefinitions>

                    <!-- 파일 선택 행 -->
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="파일:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding FilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,6,0" IsReadOnly="False"/>
                        <Button Grid.Column="2"
                                Content="찾기"
                                Command="{Binding BrowseFileCommand}"
                                Style="{StaticResource BrowseButtonStyle}"/>
                    </Grid>

                    <!-- 시트 선택 행 -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="시트:" Style="{StaticResource LabelStyle}"/>
                        <ComboBox ItemsSource="{Binding SheetNames}"
                                  SelectedItem="{Binding SelectedSheet, Mode=TwoWay}"
                                  Width="200"/>
                        <TextBlock Text="💡 드래그 앤 드롭으로 파일을 올려놓으세요"
                                   Foreground="#A0AEC0" FontSize="11"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>

                    <!-- 엑셀 미리보기 영역: ScrollViewer 안에 code-behind 에서 Grid 를 동적 생성 -->
                    <Border Grid.Row="2" BorderBrush="#CBD5E0" BorderThickness="1"
                            Background="White">
                        <ScrollViewer x:Name="PreviewScrollViewer"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <!-- code-behind 에서 PreviewGrid 에 셀을 동적으로 추가한다 -->
                            <Grid x:Name="PreviewGrid"/>
                        </ScrollViewer>
                    </Border>

                    <!-- 선택된 셀 정보 (하단) -->
                    <Border Grid.Row="3" Background="#EDF2F7" Padding="8,5" Margin="0,6,0,0"
                            CornerRadius="3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="선택된 셀: " Foreground="#718096" FontSize="12"/>
                            <TextBlock Text="{Binding SelectedCellAddress}"
                                       Foreground="#2B6CB0" FontSize="12" FontWeight="SemiBold"
                                       Margin="2,0,16,0"/>
                            <TextBlock Text="값: " Foreground="#718096" FontSize="12"/>
                            <TextBlock Text="{Binding SelectedCellValue}"
                                       Foreground="#2D3748" FontSize="12"
                                       MaxWidth="300" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════
                 우측 패널: 문서 기본 정보 + 필드 지정 + 저장
                 ══════════════════════════════════════════════════════ -->
            <Grid Grid.Column="1" Margin="12,10,12,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- 문서 기본 정보 -->
                    <RowDefinition Height="Auto"/>  <!-- 필드 지정 헤더 -->
                    <RowDefinition Height="*"/>     <!-- 필드 목록 -->
                    <RowDefinition Height="Auto"/>  <!-- 피커 모드 안내 -->
                    <RowDefinition Height="Auto"/>  <!-- 저장 버튼 -->
                </Grid.RowDefinitions>

                <!-- ── 문서 기본 정보 섹션 ── -->
                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="문서 기본 정보" Foreground="#2D3748"
                               FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>

                    <!-- 문서 이름 -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="이름:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding DocumentName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <!-- 출력 파일명 패턴 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="출력패턴:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding OutputPattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <TextBlock Text="{Binding OutputPattern, StringFormat='예: {0}'}"
                               Foreground="#A0AEC0" FontSize="11" Margin="80,2,0,0"
                               TextTrimming="CharacterEllipsis"/>

                    <!-- 생성 주기 -->
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="주기:" Style="{StaticResource LabelStyle}"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding FrequencyOptions}"
                                  SelectedItem="{Binding SelectedFrequency, Mode=TwoWay}"
                                  DisplayMemberPath="Label"/>
                        <!-- 사용자 지정 일수 (custom 선택 시만 표시) -->
                        <TextBlock Grid.Column="2" Text="일수:"
                                   VerticalAlignment="Center" Margin="8,0,4,0"
                                   Foreground="#4A5568" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCustomFrequency}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox Grid.Column="3"
                                 Text="{Binding FrequencyDays, Mode=TwoWay}"
                                 Width="44" VerticalContentAlignment="Center">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCustomFrequency}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>

                    <!-- 수장재팀 포함 여부 -->
                    <CheckBox Content="이 문서 인원에 수장재팀 포함"
                              IsChecked="{Binding IncludesSujangjae, Mode=TwoWay}"
                              Foreground="#4A5568" FontSize="12" Margin="80,6,0,4"/>

                    <!-- 사진 시트 -->
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="📷 사진 시트"
                                   Style="{StaticResource LabelStyle}"/>
                        <ComboBox  Grid.Column="1"
                                   ItemsSource="{Binding PhotoSheetOptions}"
                                   SelectedItem="{Binding SelectedPhotoSheet, Mode=TwoWay}"
                                   ToolTip="사진을 삽입할 시트. 파일을 먼저 선택하면 시트 목록이 나타납니다."/>
                        <TextBlock Grid.Column="2"
                                   Text="파일 로드 후 사진대지 시트를 고르세요."
                                   Foreground="#A0AEC0" FontSize="11"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>

                    <!-- 사진 슬롯 이름 (썸네일 카드) -->
                    <ItemsControl ItemsSource="{Binding PhotoSlotRows}" Margin="80,6,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#CBD5E0" BorderThickness="1"
                                        CornerRadius="4" Margin="0,0,8,8" Padding="6">
                                    <StackPanel Width="130">
                                        <Border Height="80" Background="#F7FAFC"
                                                BorderBrush="#E2E8F0" BorderThickness="1">
                                            <Grid>
                                                <Image Source="{Binding Thumbnail}"
                                                       Stretch="Uniform" Margin="2"/>
                                                <TextBlock Text="미리보기 없음"
                                                           Foreground="#A0AEC0" FontSize="10"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{Binding SlotIndex, StringFormat='슬롯 {0}'}"
                                                   FontSize="10" Foreground="#718096" Margin="0,4,0,1"/>
                                        <TextBlock Text="{Binding SizeHint}"
                                                   FontSize="9" Foreground="#A0AEC0" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="11"
                                                 ToolTip="메인 화면에 표시할 이름 (예: 장비 사진)"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <Separator Grid.Row="1" Background="#E2E8F0" Margin="0,0,0,8"/>

                <!-- ── 필드 지정 목록 헤더 ── -->
                <Grid Grid.Row="1" Margin="0,0,0,6">
                    <TextBlock Text="필드 지정" Foreground="#2D3748"
                               FontWeight="SemiBold" FontSize="14" Margin="0,8,0,0"/>
                </Grid>

                <!-- ── 필드 목록 + 추가 패널 ── -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- 기존 필드 목록 -->
                        <ItemsControl ItemsSource="{Binding Fields}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6" Padding="6"
                                            Background="#F7FAFC" CornerRadius="3"
                                            BorderBrush="#CBD5E0" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 필드 정보 -->
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Label}"
                                                           FontWeight="SemiBold" Foreground="#2D3748"/>

                                                <!-- 단순 필드: 상태 텍스트 -->
                                                <TextBlock Text="{Binding StatusText}"
                                                           Foreground="#718096" FontSize="11"
                                                           Visibility="{Binding IsSimpleType,
                                                               Converter={StaticResource BoolVis}}"/>

                                                <!-- 테이블 필드: 행 범위 입력 -->
                                                <StackPanel Orientation="Horizontal"
                                                            Visibility="{Binding IsTableType,
                                                                Converter={StaticResource BoolVis}}">
                                                    <TextBlock Text="시작행" Foreground="#718096"
                                                               FontSize="11" VerticalAlignment="Center"
                                                               Margin="0,0,4,0"/>
                                                    <TextBox Text="{Binding StartRow, Mode=TwoWay}"
                                                             Width="36" FontSize="11" Padding="2,1"/>
                                                    <TextBlock Text="끝행" Foreground="#718096"
                                                               FontSize="11" VerticalAlignment="Center"
                                                               Margin="6,0,4,0"/>
                                                    <TextBox Text="{Binding EndRow, Mode=TwoWay}"
                                                             Width="36" FontSize="11" Padding="2,1"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- 셀 선택 버튼 (단순 타입만) -->
                                            <Button Grid.Column="1"
                                                    Content="선택"
                                                    Command="{Binding StartPickCommand}"
                                                    Padding="6,2" FontSize="11"
                                                    Background="#2B6CB0" Foreground="White"
                                                    BorderThickness="0" Cursor="Hand"
                                                    Margin="4,0"
                                                    Visibility="{Binding IsSimpleType,
                                                        Converter={StaticResource BoolVis}}"/>

                                            <!-- 설정 버튼 (테이블 타입만) -->
                                            <Button Grid.Column="1"
                                                    Content="설정"
                                                    Tag="{Binding}"
                                                    Click="TableSetup_Click"
                                                    Padding="6,2" FontSize="11"
                                                    Background="#EDF2F7" Foreground="#4A5568"
                                                    BorderBrush="#CBD5E0" BorderThickness="1"
                                                    Cursor="Hand" Margin="4,0"
                                                    Visibility="{Binding IsTableType,
                                                        Converter={StaticResource BoolVis}}"/>

                                            <!-- 삭제 버튼 -->
                                            <Button Grid.Column="2"
                                                    Command="{Binding RemoveCommand}"
                                                    Content="×" Width="22" Height="22"
                                                    Background="#FED7D7" Foreground="#C53030"
                                                    BorderThickness="0" FontSize="13"
                                                    Cursor="Hand"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 필드 추가 패널 (ShowAddFieldPanel=true 일 때 표시) -->
                        <Border Visibility="{Binding ShowAddFieldPanel,
                                    Converter={StaticResource BoolVis}}"
                                Background="#EBF8FF" BorderBrush="#BEE3F8" BorderThickness="1"
                                CornerRadius="3" Padding="8" Margin="0,6,0,0">
                            <StackPanel>
                                <TextBlock Text="새 필드 추가" FontWeight="SemiBold"
                                           Foreground="#2C5282" Margin="0,0,0,6"/>

                                <!-- 필드명 입력 -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="필드명" VerticalAlignment="Center"
                                               Foreground="#4A5568" FontSize="12"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding NewFieldLabel, Mode=TwoWay,
                                                 UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>

                                <!-- 타입 선택 -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="타입" VerticalAlignment="Center"
                                               Foreground="#4A5568" FontSize="12"/>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding FieldTypeOptions}"
                                              SelectedItem="{Binding NewFieldType, Mode=TwoWay}"
                                              DisplayMemberPath="Label"/>
                                </Grid>

                                <!-- 확인/취소 버튼 -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="취소"
                                            Command="{Binding CancelAddFieldCommand}"
                                            Padding="10,4" Margin="0,0,6,0"
                                            Background="#EDF2F7" BorderBrush="#CBD5E0"
                                            BorderThickness="1" Cursor="Hand"/>
                                    <Button Content="추가"
                                            Command="{Binding ConfirmAddFieldCommand}"
                                            Padding="10,4"
                                            Background="#2B6CB0" Foreground="White"
                                            BorderThickness="0" Cursor="Hand"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- + 필드 추가 버튼 -->
                        <Button Content="+ 필드 추가"
                                Command="{Binding AddFieldCommand}"
                                HorizontalAlignment="Left" Margin="0,8,0,0"
                                Padding="10,4" Background="#48BB78" Foreground="White"
                                BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>

                    </StackPanel>
                </ScrollViewer>

                <!-- ── 피커 모드 활성 안내 패널 ── -->
                <Border Grid.Row="3" Background="#EBF8FF" BorderBrush="#90CDF4"
                        BorderThickness="1" CornerRadius="4" Padding="10,8"
                        Margin="0,8,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <!-- 기본: 숨김 -->
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <!-- 피커 모드 활성이면 표시 -->
                                <DataTrigger Binding="{Binding IsPickerActive}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="👆" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="왼쪽 미리보기에서 셀을 클릭하면 자동으로 지정됩니다."
                                   Foreground="#2C5282" FontSize="12" VerticalAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- ── 저장 버튼 ── -->
                <Border Grid.Row="4" Padding="0,12,0,0">
                    <Button Content="💾  저장"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource SaveButtonStyle}"
                            Height="36" HorizontalAlignment="Stretch"
                            FontSize="13" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
