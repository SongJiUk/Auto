<Window x:Class="FormFiller.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FormFiller.App.ViewModels.Settings"
        Title="설정" Height="780" Width="720"
        MinHeight="560" MinWidth="560"
        FontFamily="Malgun Gothic" FontSize="13"
        WindowStartupLocation="CenterOwner">

    <Window.DataContext>
        <vm:SettingsViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <!-- GroupBox 기본 -->
        <Style TargetType="GroupBox">
            <Setter Property="Margin"      Value="0,0,0,12"/>
            <Setter Property="Padding"     Value="10,8"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="Foreground"  Value="#2D3748"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
        </Style>

        <!-- 항목 레이블 -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground"        Value="#4A5568"/>
            <Setter Property="Margin"            Value="0,0,6,0"/>
        </Style>

        <!-- 작은 레이블 -->
        <Style x:Key="SmallLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground"        Value="#718096"/>
            <Setter Property="FontSize"          Value="12"/>
            <Setter Property="Margin"            Value="0,0,4,0"/>
        </Style>

        <!-- 기본 TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Padding"             Value="4,3"/>
            <Setter Property="BorderBrush"         Value="#CBD5E0"/>
            <Setter Property="BorderThickness"     Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- 셀 주소 TextBox (좁고 가운데 정렬) -->
        <Style x:Key="CellBox" TargetType="TextBox">
            <Setter Property="Width"           Value="60"/>
            <Setter Property="TextAlignment"   Value="Center"/>
            <Setter Property="Padding"         Value="4,3"/>
            <Setter Property="BorderBrush"     Value="#4299E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- 작은 숫자 TextBox -->
        <Style x:Key="SmallNum" TargetType="TextBox">
            <Setter Property="Width"           Value="46"/>
            <Setter Property="TextAlignment"   Value="Center"/>
            <Setter Property="Padding"         Value="4,3"/>
            <Setter Property="BorderBrush"     Value="#CBD5E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- 작은 열문자 TextBox -->
        <Style x:Key="SmallCol" TargetType="TextBox">
            <Setter Property="Width"           Value="40"/>
            <Setter Property="TextAlignment"   Value="Center"/>
            <Setter Property="Padding"         Value="4,3"/>
            <Setter Property="BorderBrush"     Value="#CBD5E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- 찾아보기 버튼 -->
        <Style x:Key="BrowseBtn" TargetType="Button">
            <Setter Property="Background"      Value="#EBF8FF"/>
            <Setter Property="Foreground"      Value="#2B6CB0"/>
            <Setter Property="BorderBrush"     Value="#BEE3F8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="10,4"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#BEE3F8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 삭제 버튼 -->
        <Style x:Key="DeleteBtn" TargetType="Button">
            <Setter Property="Background"      Value="#FFF5F5"/>
            <Setter Property="Foreground"      Value="#C53030"/>
            <Setter Property="BorderBrush"     Value="#FEB2B2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="8,3"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FEB2B2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ════════════════════════════════════════════════════════
             문서 1개를 렌더링하는 DataTemplate
             ════════════════════════════════════════════════════════ -->
        <DataTemplate DataType="{x:Type vm:DocumentEditViewModel}">
            <GroupBox>
                <GroupBox.Header>
                    <!-- 문서명 + 삭제 버튼 -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"
                                   Foreground="#2D3748" VerticalAlignment="Center"/>
                        <Button Content="✏ Excel 에서 편집"
                                Click="EditDocument_Click" Tag="{Binding}"
                                Margin="12,0,0,0" Padding="8,2" VerticalAlignment="Center"
                                Background="#EBF8FF" Foreground="#2B6CB0" BorderBrush="#90CDF4" Cursor="Hand"
                                ToolTip="서식을 열어 칸·사진·위치를 클릭으로 다시 지정합니다"/>
                        <Button Content="✕ 삭제"
                                Command="{Binding DeleteDocumentCommand}"
                                Style="{StaticResource DeleteBtn}"
                                Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </GroupBox.Header>

                <StackPanel>
                    <!-- ── 파일 경로 ── -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="서식 파일" Style="{StaticResource LabelStyle}" Width="70"/>
                        <TextBox  Grid.Column="1"
                                  Text="{Binding TemplateFile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="0,0,6,0" IsReadOnly="False"/>
                        <Button   Grid.Column="2" Content="찾아보기"
                                  Command="{Binding BrowseFileCommand}"
                                  Style="{StaticResource BrowseBtn}"/>
                    </Grid>

                    <!-- ── 출력 패턴 ── -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="출력 패턴" Style="{StaticResource LabelStyle}" Width="70"/>
                        <TextBox   Grid.Column="1"
                                   Text="{Binding OutputPattern, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                    </Grid>

                    <!-- ── 시트 선택 ── -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="시트" Style="{StaticResource LabelStyle}" Width="70"/>
                        <ComboBox ItemsSource="{Binding SheetNames}"
                                  SelectedItem="{Binding SelectedSheet, Mode=TwoWay}"
                                  Width="200"/>
                    </StackPanel>

                    <!-- ── 주기 ── -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="생성 주기" Style="{StaticResource LabelStyle}" Width="70"/>
                        <ComboBox ItemsSource="{Binding FrequencyOptions}"
                                  SelectedItem="{Binding SelectedFrequency, Mode=TwoWay}"
                                  DisplayMemberPath="Label" Width="120"/>
                        <!-- 사용자 지정 일수 (custom 선택 시만 표시) -->
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsCustomFrequency, Converter={StaticResource BoolVis}}"
                                    Margin="8,0,0,0">
                            <TextBlock Text="매" Style="{StaticResource SmallLabel}"/>
                            <TextBox Text="{Binding FrequencyDays, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     Style="{StaticResource SmallNum}"/>
                            <TextBlock Text="일" Style="{StaticResource SmallLabel}" Margin="4,0,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- ── 수장재팀 포함 ── -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="수장재팀" Style="{StaticResource LabelStyle}" Width="70"/>
                        <CheckBox IsChecked="{Binding IncludesSujangjae, Mode=TwoWay}"
                                  Content="인원에 수장재팀 포함" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- ── 사진 시트 ── -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="📷 사진 시트" Style="{StaticResource LabelStyle}" Width="70"/>
                        <ComboBox ItemsSource="{Binding PhotoSheetOptions}"
                                  SelectedItem="{Binding SelectedPhotoSheet, Mode=TwoWay}"
                                  Width="220"
                                  ToolTip="사진을 삽입할 시트. 서식 파일 경로를 입력하면 목록이 채워집니다."/>
                    </StackPanel>

                    <!-- ── 사진 슬롯 이름 (썸네일 + 이름 입력) ── -->
                    <ItemsControl ItemsSource="{Binding PhotoSlotRows}" Margin="76,4,0,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#CBD5E0" BorderThickness="1"
                                        CornerRadius="4" Margin="0,0,8,8" Padding="6">
                                    <StackPanel Width="130">
                                        <!-- 썸네일 -->
                                        <Border Height="80" Background="#F7FAFC"
                                                BorderBrush="#E2E8F0" BorderThickness="1">
                                            <Grid>
                                                <Image Source="{Binding Thumbnail}"
                                                       Stretch="Uniform" Margin="2"/>
                                                <TextBlock Text="미리보기 없음"
                                                           Foreground="#A0AEC0" FontSize="10"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                        <!-- 슬롯 번호 + 크기 -->
                                        <TextBlock Text="{Binding SlotIndex, StringFormat='슬롯 {0}'}"
                                                   FontSize="10" Foreground="#718096"
                                                   Margin="0,4,0,1"/>
                                        <TextBlock Text="{Binding SizeHint}"
                                                   FontSize="9" Foreground="#A0AEC0"
                                                   Margin="0,0,0,4"/>
                                        <!-- 이름 입력 -->
                                        <TextBox Text="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="11"
                                                 ToolTip="메인 화면에 표시할 이름 (예: 장비 사진)"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Separator Background="#EDF2F7" Margin="0,0,0,8"/>

                    <!-- ── 필드 목록 헤더 ── -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="필드" Foreground="#718096" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="타입" Foreground="#718096" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2" Text="설정값" Foreground="#718096" FontSize="11" FontWeight="SemiBold" Margin="6,0"/>
                    </Grid>
                    <Separator Background="#EDF2F7" Margin="0,0,0,4"/>

                    <!-- ── 필드 행 목록 ── -->
                    <ItemsControl ItemsSource="{Binding Fields}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:FieldEditRow}">
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 필드명 -->
                                    <TextBlock Grid.Column="0" Text="{Binding Label}"
                                               Style="{StaticResource LabelStyle}"
                                               TextTrimming="CharacterEllipsis"/>

                                    <!-- 타입 (회색 소문자) -->
                                    <TextBlock Grid.Column="1" Text="{Binding Type}"
                                               Foreground="#A0AEC0" FontSize="10"
                                               VerticalAlignment="Center"/>

                                    <!-- ─ 단순 셀 / 멀티라인 : 셀 주소 1개 ─ -->
                                    <TextBox Grid.Column="2"
                                             Visibility="{Binding IsSimpleType, Converter={StaticResource BoolVis}}"
                                             Text="{Binding CellAddress, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource CellBox}"
                                             HorizontalAlignment="Left"
                                             Margin="6,0"/>

                                    <!-- ─ 테이블 : 행·열 설정 ─ -->
                                    <WrapPanel Grid.Column="2"
                                               Visibility="{Binding IsTableType, Converter={StaticResource BoolVis}}"
                                               Margin="6,0" Orientation="Horizontal">

                                        <!-- 공통: 시작행·끝행·금일열 -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,8,2">
                                            <TextBlock Text="시작행" Style="{StaticResource SmallLabel}"/>
                                            <TextBox Text="{Binding StartRow, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                     Style="{StaticResource SmallNum}" Margin="0,0,6,0"/>
                                            <TextBlock Text="끝행" Style="{StaticResource SmallLabel}"/>
                                            <TextBox Text="{Binding EndRow, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                     Style="{StaticResource SmallNum}" Margin="0,0,6,0"/>
                                            <TextBlock Text="금일열" Style="{StaticResource SmallLabel}"/>
                                            <TextBox Text="{Binding TodayCol, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                     Style="{StaticResource SmallCol}"/>
                                        </StackPanel>

                                        <!-- equipment_table 전용 -->
                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding IsEquipTable, Converter={StaticResource BoolVis}}"
                                                    Margin="0,0,0,2">
                                            <TextBlock Text="장비명열" Style="{StaticResource SmallLabel}"/>
                                            <TextBox Text="{Binding NameCol, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                     Style="{StaticResource SmallCol}" Margin="0,0,6,0"/>
                                            <TextBlock Text="전일열" Style="{StaticResource SmallLabel}"/>
                                            <TextBox Text="{Binding PrevDayCol, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                     Style="{StaticResource SmallCol}"/>
                                        </StackPanel>

                                        <!-- personnel_table 전용 -->
                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding IsPersonTable, Converter={StaticResource BoolVis}}"
                                                    Margin="0,0,0,2">
                                            <TextBlock Text="직종열" Style="{StaticResource SmallLabel}"/>
                                            <TextBox Text="{Binding RoleCol, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                     Style="{StaticResource SmallCol}" Margin="0,0,6,0"/>
                                            <TextBlock Text="전일누계열" Style="{StaticResource SmallLabel}"/>
                                            <TextBox Text="{Binding PrevCumulativeCol, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                     Style="{StaticResource SmallCol}"/>
                                        </StackPanel>

                                    </WrapPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </GroupBox>
        </DataTemplate>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 헤더 -->
            <RowDefinition Height="*"/>     <!-- 본문 -->
            <RowDefinition Height="Auto"/>  <!-- 하단 -->
        </Grid.RowDefinitions>

        <!-- ── 헤더 ── -->
        <Border Grid.Row="0" Background="#2B6CB0" Padding="16,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚙ 설정" Foreground="White"
                           FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Foreground="#BEE3F8" FontSize="12" Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Text="등록된 문서 목록 · 셀 주소 · 파일 경로 수정"/>
            </StackPanel>
        </Border>

        <!-- ── 본문 (스크롤) ── -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,10">
            <StackPanel>
                <!-- 문서가 없을 때 안내 -->
                <TextBlock Text="등록된 문서가 없습니다. '새 문서 추가'로 추가해 주세요."
                           Foreground="#A0AEC0" FontSize="13" Margin="0,20,0,0"
                           HorizontalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Documents.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- 문서 목록 -->
                <ItemsControl ItemsSource="{Binding Documents}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ── 하단 버튼 영역 ── -->
        <Border Grid.Row="2" Background="#EBF8FF" BorderBrush="#BEE3F8"
                BorderThickness="0,1,0,0" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 새 문서 추가 버튼 -->
                <Button Grid.Column="0"
                        Content="+ 새 문서 추가"
                        Click="AddDocument_Click"
                        Height="34" Padding="12,6"
                        Margin="0,0,12,0" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background"      Value="#48BB78"/>
                            <Setter Property="Foreground"      Value="White"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FontWeight"      Value="SemiBold"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="4" Padding="12,6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#38A169"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- 안내 -->
                <TextBlock Grid.Column="1"
                           Text="※ 셀 주소 변경 후 Tab 또는 다른 곳 클릭 시 적용됩니다."
                           Foreground="#718096" FontSize="11" VerticalAlignment="Center"/>

                <!-- 저장 버튼 -->
                <Button Grid.Column="2"
                        Command="{Binding SaveCommand}"
                        Content="💾  저장"
                        Width="110" Height="34"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background"      Value="#2B6CB0"/>
                            <Setter Property="Foreground"      Value="White"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FontSize"        Value="13"/>
                            <Setter Property="FontWeight"      Value="SemiBold"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="4" Padding="12,0">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#2C5282"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
