<Window x:Class="FormFiller.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FormFiller.App.ViewModels.Settings"
        Title="문서 관리" Height="720" Width="900"
        MinHeight="520" MinWidth="720"
        FontFamily="Malgun Gothic" FontSize="13"
        WindowStartupLocation="CenterOwner">

    <Window.DataContext>
        <vm:SettingsViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground"        Value="#4A5568"/>
            <Setter Property="Width"             Value="96"/>
        </Style>

        <Style x:Key="SmallLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground"        Value="#718096"/>
            <Setter Property="FontSize"          Value="12"/>
            <Setter Property="Margin"            Value="0,0,4,0"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding"                  Value="4,3"/>
            <Setter Property="BorderBrush"              Value="#CBD5E0"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- 공통 버튼: 배경색만 바꿔 쓴다 -->
        <Style x:Key="FlatBtn" TargetType="Button">
            <Setter Property="Background"      Value="#EBF8FF"/>
            <Setter Property="Foreground"      Value="#2B6CB0"/>
            <Setter Property="BorderBrush"     Value="#BEE3F8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="12,6"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource FlatBtn}">
            <Setter Property="Background"  Value="#2B6CB0"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="BorderBrush" Value="#2B6CB0"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
        </Style>

        <Style x:Key="AddBtn" TargetType="Button" BasedOn="{StaticResource FlatBtn}">
            <Setter Property="Background"  Value="#48BB78"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="BorderBrush" Value="#48BB78"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
        </Style>

        <Style x:Key="DeleteBtn" TargetType="Button" BasedOn="{StaticResource FlatBtn}">
            <Setter Property="Background"  Value="#FFF5F5"/>
            <Setter Property="Foreground"  Value="#C53030"/>
            <Setter Property="BorderBrush" Value="#FEB2B2"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 헤더 -->
            <RowDefinition Height="*"/>     <!-- 본문 -->
            <RowDefinition Height="Auto"/>  <!-- 하단 -->
        </Grid.RowDefinitions>

        <!-- ── 헤더 ── -->
        <Border Grid.Row="0" Background="#2B6CB0" Padding="16,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📁 문서 관리" Foreground="White"
                           FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Foreground="#BEE3F8" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"
                           Text="왼쪽에서 문서를 고르고, 칸은 [✏ 칸 편집]에서 지정합니다"/>
            </StackPanel>
        </Border>

        <!-- ── 본문: 왼쪽 목록 / 오른쪽 상세 ── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 왼쪽: 문서 목록 -->
            <Border Grid.Column="0" Background="#F7FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
                <DockPanel Margin="10">
                    <Button DockPanel.Dock="Bottom" Content="+ 새 문서" Click="AddDocument_Click"
                            Style="{StaticResource AddBtn}" Margin="0,10,0,0" Height="36"/>
                    <TextBlock DockPanel.Dock="Top" Text="문서" Foreground="#718096" FontSize="12"
                               FontWeight="SemiBold" Margin="2,0,0,6"/>
                    <ListBox ItemsSource="{Binding Documents}" SelectedItem="{Binding SelectedDocument, Mode=TwoWay}"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="Margin"  Value="0,0,0,4"/>
                                <Setter Property="Cursor"  Value="Hand"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DocumentEditViewModel}">
                                <StackPanel>
                                    <TextBlock Text="{Binding ListTitle}" FontWeight="SemiBold" Foreground="#2D3748"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding ListSubtitle}" FontSize="11" Foreground="#718096"
                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 문서가 하나도 없을 때 -->
            <TextBlock Grid.Column="1" Text="등록된 문서가 없습니다. 왼쪽 아래 [+ 새 문서]로 추가해 주세요."
                       Foreground="#A0AEC0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSelection}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- 오른쪽: 고른 문서 -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}}">
                <StackPanel Margin="18,14" DataContext="{Binding SelectedDocument}">

                    <!-- 제목 + 버튼 -->
                    <DockPanel Margin="0,0,0,14">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="✏ 칸 편집" Click="EditDocument_Click" Style="{StaticResource PrimaryBtn}"
                                    ToolTip="서식을 열어 칸·사진·위치를 클릭으로 지정합니다"/>
                            <Button Content="🧪 시험 생성" Command="{Binding TestGenerateCommand}"
                                    Style="{StaticResource FlatBtn}" Margin="6,0,0,0"
                                    ToolTip="지금 설정으로 오늘 파일을 임시 폴더에 만들어 봅니다 (실제 출력 폴더는 그대로)"/>
                            <Button Content="삭제" Command="{Binding DataContext.DeleteCommand,
                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                    Style="{StaticResource DeleteBtn}" Margin="6,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ListTitle}" FontSize="18" FontWeight="Bold" Foreground="#2D3748"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>

                    <!-- 기본 정보 -->
                    <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="문서 이름" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>

                            <DockPanel Margin="0,0,0,2">
                                <TextBlock Text="서식 파일" Style="{StaticResource LabelStyle}"/>
                                <Button DockPanel.Dock="Right" Content="찾아보기" Command="{Binding BrowseFileCommand}"
                                        Style="{StaticResource FlatBtn}" Padding="10,3" Margin="6,0,0,0"/>
                                <TextBox Text="{Binding TemplateFile, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                            </DockPanel>
                            <TextBlock Text="⚠ 서식 파일을 찾을 수 없습니다. [찾아보기]로 다시 골라 주세요."
                                       Foreground="#C05621" FontSize="12" Margin="96,2,0,0"
                                       Visibility="{Binding TemplateMissing, Converter={StaticResource BoolVis}}"/>

                            <DockPanel Margin="0,8,0,8">
                                <TextBlock Text="만들 파일 이름" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding OutputPattern, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         ToolTip="{}{yy}.{MM}.{dd} 자리에 날짜가 들어갑니다. 예: {yy}.{MM}.{dd} 공사일보.xlsx"/>
                            </DockPanel>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="만드는 주기" Style="{StaticResource LabelStyle}"/>
                                <ComboBox ItemsSource="{Binding FrequencyOptions}"
                                          SelectedItem="{Binding SelectedFrequency, Mode=TwoWay}"
                                          DisplayMemberPath="Label" Width="120"/>
                                <StackPanel Orientation="Horizontal" Margin="8,0,0,0"
                                            Visibility="{Binding IsCustomFrequency, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="매" Style="{StaticResource SmallLabel}"/>
                                    <TextBox Text="{Binding FrequencyDays, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Width="46" TextAlignment="Center"/>
                                    <TextBlock Text="일" Style="{StaticResource SmallLabel}" Margin="4,0,0,0"/>
                                </StackPanel>
                                <ComboBox ItemsSource="{Binding WeekdayOptions}" SelectedItem="{Binding SelectedWeekday, Mode=TwoWay}"
                                          DisplayMemberPath="Label" Width="80" Margin="8,0,0,0"
                                          Visibility="{Binding IsWeeklyFrequency, Converter={StaticResource BoolVis}}"/>
                            </StackPanel>
                            <CheckBox Content="파일 날짜를 그 주 정한 요일로 (끄면 만드는 날 날짜)"
                                      IsChecked="{Binding UseWeeklyDayDate, Mode=TwoWay}"
                                      Margin="96,6,0,0" Foreground="#4A5568"
                                      Visibility="{Binding IsWeeklyFrequency, Converter={StaticResource BoolVis}}"/>
                        </StackPanel>
                    </Border>

                    <!-- 항목 요약 (읽기 전용) -->
                    <TextBlock Margin="0,0,0,6" Foreground="#2D3748" FontWeight="SemiBold">
                        <Run Text="채우는 칸"/>
                        <Run Text="{Binding Fields.Count, Mode=OneWay, StringFormat='({0}개)'}" Foreground="#718096" FontWeight="Normal"/>
                    </TextBlock>
                    <Border Background="#FFFAF0" BorderBrush="#FBD38D" BorderThickness="1" CornerRadius="4"
                            Padding="10,6" Margin="0,0,0,8"
                            Visibility="{Binding HasLegacyFields, Converter={StaticResource BoolVis}}">
                        <TextBlock TextWrapping="Wrap" Foreground="#9C4221" FontSize="12"
                                   Text="'예전 방식' 항목이 있습니다. 그대로도 만들어지지만, [✏ 칸 편집]에서 다시 지정하면 오늘 작성 화면이 더 깔끔해집니다."/>
                    </Border>

                    <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6">
                        <ItemsControl ItemsSource="{Binding Fields}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:FieldEditRow}">
                                    <Border BorderBrush="#EDF2F7" BorderThickness="0,0,0,1" Padding="12,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="170"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Label}" Foreground="#2D3748"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding KeyText, StringFormat='값 이름: {0}'}"
                                                           FontSize="11" Foreground="#A0AEC0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding KeyText}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                    CornerRadius="10" Padding="8,1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#EBF8FF"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLegacy}" Value="True">
                                                                <Setter Property="Background" Value="#FEEBC8"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding TypeTitle}" FontSize="11" Foreground="#2C5282"/>
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding CellSummary}" Foreground="#4A5568"
                                                       FontSize="12" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ── 하단 ── -->
        <Border Grid.Row="2" Background="#EBF8FF" BorderBrush="#BEE3F8" BorderThickness="0,1,0,0" Padding="12,8">
            <DockPanel>
                <Button DockPanel.Dock="Right" Command="{Binding SaveCommand}" Content="💾  저장"
                        Style="{StaticResource PrimaryBtn}" Width="110" Height="34"/>
                <TextBlock Text="이름·파일·주기를 고쳤으면 [저장]을 누르세요. [✏ 칸 편집]을 누르면 먼저 자동 저장됩니다."
                           Foreground="#718096" FontSize="11" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
