<Window x:Class="FormFiller.App.Views.WorkItemPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="작업 항목 선택" Height="480" Width="440"
        WindowStartupLocation="CenterOwner"
        FontFamily="Malgun Gothic" FontSize="13"
        ResizeMode="CanResize" MinHeight="360" MinWidth="340">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding"       Value="10,4"/>
            <Setter Property="BorderBrush"   Value="#CBD5E0"/>
            <Setter Property="Cursor"        Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 헤더 -->
        <TextBlock Grid.Row="0" Text="항목을 체크하거나 직접 입력하세요."
                   Foreground="#4A5568" FontSize="12" Margin="0,0,0,8"/>

        <!-- 미리 설정된 항목 목록 -->
        <Border Grid.Row="1" BorderBrush="#CBD5E0" BorderThickness="1" CornerRadius="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="PresetPanel" Margin="4"/>
            </ScrollViewer>
        </Border>

        <!-- 직접 입력 -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="CustomTextBox"
                     Grid.Column="0"
                     Padding="6,4"
                     BorderBrush="#CBD5E0"
                     ToolTip="직접 입력..."
                     KeyDown="CustomTextBox_KeyDown"/>
            <Button Grid.Column="1" Content="목록에 추가"
                    Margin="6,0,0,0"
                    Click="AddToPreset_Click"
                    Background="#EBF8FF" Foreground="#2B6CB0" BorderBrush="#BEE3F8"/>
            <Button Grid.Column="2" Content="바로 추가"
                    Margin="6,0,0,0"
                    Click="AddDirect_Click"
                    Background="#F0FFF4" Foreground="#276749" BorderBrush="#9AE6B4"/>
        </Grid>

        <!-- 하단 버튼 -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       x:Name="HintText"
                       Foreground="#718096" FontSize="11"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="선택 추가"
                    Margin="0,0,8,0"
                    Background="#2B6CB0" Foreground="White" BorderThickness="0"
                    Click="Confirm_Click"/>
            <Button Grid.Column="2" Content="취소"
                    Click="Cancel_Click"
                    Background="#EDF2F7"/>
        </Grid>
    </Grid>
</Window>
