<Window x:Class="FormFiller.App.Views.GenerateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FormFiller.App.ViewModels"
        Title="{Binding Title}" Width="560" SizeToContent="Height" MaxHeight="720"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FontFamily="Malgun Gothic" FontSize="13" Background="White">

    <!-- 생성 전 확인(IsChecking)과 생성 결과(IsDone)를 같은 창에서 바꿔 보여 준다 -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#2B6CB0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="16,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2C5282"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#A0AEC0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background"  Value="#EDF2F7"/>
            <Setter Property="Foreground"  Value="#2D3748"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                BorderBrush="#CBD5E0" BorderThickness="1" Padding="14,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18,16,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 요약 한 줄 -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding CheckSummary}" FontWeight="SemiBold" Foreground="#2D3748"
                       TextWrapping="Wrap"
                       Visibility="{Binding IsChecking, Converter={StaticResource BoolVis}}"/>
            <TextBlock Text="{Binding ResultSummary}" FontWeight="SemiBold" FontSize="14"
                       Visibility="{Binding IsDone, Converter={StaticResource BoolVis}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#276749"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasFailures}" Value="True">
                                <Setter Property="Foreground" Value="#C05621"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <!-- 문서 목록 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Docs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DocCheckItem}">
                            <Border Margin="0,0,0,8" Padding="12,9" CornerRadius="6" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                        <Setter Property="Background"  Value="#F7FAFC"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                                <Setter Property="BorderBrush" Value="#FEB2B2"/>
                                                <Setter Property="Background"  Value="#FFF5F5"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <DockPanel>
                                        <!-- 결과 화면: [열기] -->
                                        <Button DockPanel.Dock="Right" Content="열기" Command="{Binding OpenCommand}"
                                                Style="{StaticResource SecondaryBtn}" VerticalAlignment="Center"
                                                Visibility="{Binding IsOk, Converter={StaticResource BoolVis}}"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#2D3748"/>
                                            <TextBlock Text="{Binding OutputFileName}" FontSize="11" Foreground="#718096"
                                                       Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- 확인 화면: 문제 목록 -->
                                    <StackPanel Margin="0,6,0,0"
                                                Visibility="{Binding DataContext.IsChecking,
                                                             RelativeSource={RelativeSource AncestorType=Window},
                                                             Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="✔ 확인할 것 없음" Foreground="#276749" FontSize="12"
                                                   Visibility="{Binding NoIssues, Converter={StaticResource BoolVis}}"/>
                                        <ItemsControl ItemsSource="{Binding Issues}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:CheckIssue}">
                                                    <DockPanel Margin="0,2">
                                                        <Border DockPanel.Dock="Left" Width="16" Height="16" CornerRadius="8"
                                                                Margin="0,1,8,0" VerticalAlignment="Top">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#DD6B20"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                            <Setter Property="Background" Value="#E53E3E"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding Icon}" Foreground="White" FontSize="10"
                                                                       FontWeight="Bold" HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#9C4221"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                            <Setter Property="Foreground" Value="#C53030"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- 결과 화면: 생성 결과 -->
                                    <TextBlock Text="{Binding ResultText}" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Setter Property="Foreground" Value="#276749"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOk}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Setter Property="Foreground" Value="#C53030"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 결과 화면: 참고 사항 -->
                <Expander Header="참고 사항 보기" Margin="0,2,0,0" Foreground="#4A5568"
                          Visibility="{Binding HasNotes, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding NotesText}" FontSize="11" Foreground="#718096"
                               TextWrapping="Wrap" Margin="4,6,0,0"/>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <!-- 확인 화면: 생성 후 바로 열기 -->
        <CheckBox Grid.Row="2" Content="생성 후 바로 Excel로 열기" Margin="0,12,0,0"
                  IsChecked="{Binding OpenAfter}" Foreground="#4A5568"
                  Visibility="{Binding IsChecking, Converter={StaticResource BoolVis}}"/>

        <!-- 버튼 -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        Visibility="{Binding IsChecking, Converter={StaticResource BoolVis}}">
                <Button Content="돌아가서 고치기" IsCancel="True" Style="{StaticResource SecondaryBtn}"/>
                <Button Content="{Binding GenerateButtonText}" Command="{Binding GenerateCommand}"
                        IsDefault="True" Style="{StaticResource PrimaryBtn}" Margin="8,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        Visibility="{Binding IsDone, Converter={StaticResource BoolVis}}">
                <Button Content="📂 폴더 열기" Command="{Binding OpenFolderCommand}" Style="{StaticResource SecondaryBtn}"/>
                <Button Content="모두 Excel로 열기" Command="{Binding OpenAllCommand}"
                        Style="{StaticResource SecondaryBtn}" Margin="8,0,0,0"/>
                <Button Content="닫기" IsCancel="True" Style="{StaticResource PrimaryBtn}" Margin="8,0,0,0"
                        Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
