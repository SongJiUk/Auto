<Window x:Class="FormFiller.App.Views.DriveSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FormFiller.App.ViewModels"
        Title="☁ 구글 드라이브" Width="640" Height="640"
        MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        FontFamily="Malgun Gothic" FontSize="13" Background="White">

    <!-- DataContext 에 ViewModel 을 넣으면, 아래 {Binding 이름} 이 ViewModel 의 같은 이름 프로퍼티를 읽는다 -->
    <Window.DataContext>
        <vm:DriveSettingsViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2B6CB0"/>
            <Setter Property="Margin"     Value="0,16,0,8"/>
        </Style>
        <Style x:Key="SmallBtn" TargetType="Button">
            <Setter Property="Padding"         Value="10,3"/>
            <Setter Property="Background"      Value="#EBF8FF"/>
            <Setter Property="Foreground"      Value="#2B6CB0"/>
            <Setter Property="BorderBrush"     Value="#BEE3F8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="20,12,20,12">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Foreground="#4A5568" LineHeight="20">
                    이 프로그램은 구글 드라이브에 직접 로그인하지 않습니다.
                    PC 에 설치한 <Run FontWeight="SemiBold" Text="Google Drive 데스크톱"/> 이 '내 드라이브' 폴더를 두 PC 에 똑같이 맞춰 주고,
                    프로그램은 그 폴더를 씁니다. 그래서 두 PC 모두 드라이브 앱이 켜져 있어야 합니다.
                </TextBlock>

                <!-- ── 점검 결과 ── -->
                <DockPanel Margin="0,16,0,8">
                    <Button DockPanel.Dock="Right" Content="↻ 다시 확인" Style="{StaticResource SmallBtn}"
                            Command="{Binding RecheckCommand}"/>
                    <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{Binding SummaryColor}" TextWrapping="Wrap"/>
                </DockPanel>

                <!-- ItemsControl: 목록(Checks)의 항목마다 아래 DataTemplate 모양을 하나씩 만든다 -->
                <ItemsControl ItemsSource="{Binding Checks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding Background}" CornerRadius="4" Padding="10,8" Margin="0,0,0,6">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" Foreground="{Binding Color}"
                                               FontWeight="Bold" FontSize="15" Width="24" VerticalAlignment="Top"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#2D3748"/>
                                        <TextBlock Text="{Binding Detail}" Foreground="#4A5568" FontSize="12"
                                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding Fix}" Foreground="{Binding Color}" FontSize="12"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"
                                                   Visibility="{Binding HasFix, Converter={StaticResource BoolVis}}"/>
                                        <Button Content="🌐 Google Drive 다운로드 페이지 열기" HorizontalAlignment="Left"
                                                Margin="0,6,0,0" Style="{StaticResource SmallBtn}"
                                                Command="{Binding DataContext.OpenDownloadCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                Visibility="{Binding OfferDownload, Converter={StaticResource BoolVis}}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ── 폴더 설정 ── -->
                <TextBlock Style="{StaticResource H1}" Text="폴더"/>

                <TextBlock Text="출력 폴더 (만든 파일 저장, 전일 누계도 여기서 읽음)" Foreground="#4A5568" Margin="0,0,0,4"/>
                <DockPanel Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Content="📂 열기" Margin="6,0,0,0"
                            Style="{StaticResource SmallBtn}" Command="{Binding OpenOutputCommand}"/>
                    <Button DockPanel.Dock="Right" Content="찾아보기…" Margin="6,0,0,0"
                            Style="{StaticResource SmallBtn}" Command="{Binding BrowseOutputCommand}"/>
                    <TextBox Text="{Binding OutputFolder, Mode=OneWay}" IsReadOnly="True"
                             Padding="4,3" BorderBrush="#CBD5E0" Background="#F7FAFC"/>
                </DockPanel>

                <TextBlock Text="사진 폴더 (사진 칸이 있는 문서)" Foreground="#4A5568" Margin="0,0,0,4"/>
                <TextBlock Text="사진 칸이 있는 문서가 없습니다." Foreground="#A0AEC0" FontSize="12" x:Name="NoPhotoText"/>
                <ItemsControl ItemsSource="{Binding PhotoFolders}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding DocName}" Width="130"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding DocName}"/>
                                <Button DockPanel.Dock="Right" Content="찾아보기…" Margin="6,0,0,0"
                                        Style="{StaticResource SmallBtn}" Command="{Binding BrowseCommand}"/>
                                <TextBox Text="{Binding FolderText, Mode=OneWay}" IsReadOnly="True"
                                         Padding="4,3" BorderBrush="#CBD5E0" Background="#F7FAFC"/>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock TextWrapping="Wrap" Foreground="#A0AEC0" FontSize="11" Margin="0,10,0,0">
                    두 PC 의 드라이브 문자가 달라도(예: 회사 G:, 집 H:) '내 드라이브' 안 폴더면 자동으로 맞춰 찾습니다.
                </TextBlock>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,10">
            <Button Content="닫기" HorizontalAlignment="Right" Padding="20,4" IsCancel="True" Click="Close_Click"/>
        </Border>
    </Grid>
</Window>
