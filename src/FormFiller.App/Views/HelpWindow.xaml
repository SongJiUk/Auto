<Window x:Class="FormFiller.App.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="사용법" Width="620" Height="720"
        WindowStartupLocation="CenterOwner"
        FontFamily="Malgun Gothic" FontSize="13" Background="White">

    <!-- 처음 쓰는 사람을 위한 안내. 처음 실행할 때 자동으로 뜨고, 상단 [❓ 사용법] 으로 다시 볼 수 있다 -->
    <Window.Resources>
        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2B6CB0"/>
            <Setter Property="Margin"     Value="0,18,0,8"/>
        </Style>
        <Style x:Key="Num" TargetType="Border">
            <Setter Property="Width"        Value="22"/>
            <Setter Property="Height"       Value="22"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Background"   Value="#2B6CB0"/>
            <Setter Property="Margin"       Value="0,0,10,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="NumText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
        </Style>
        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground"   Value="#2D3748"/>
            <Setter Property="LineHeight"   Value="20"/>
        </Style>
        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="24,8,24,16">
            <StackPanel>

                <!-- ── 처음 한 번 ── -->
                <TextBlock Style="{StaticResource H1}" Text="처음 한 번만 하는 것 (기준 잡기)"/>

                <DockPanel Style="{StaticResource Row}">
                    <Border Style="{StaticResource Num}"><TextBlock Style="{StaticResource NumText}" Text="1"/></Border>
                    <TextBlock Style="{StaticResource Body}">
                        <Run FontWeight="SemiBold" Text="서식 등록"/><LineBreak/>
                        오른쪽 위 [⚙ 설정] → [+ 문서 추가]에서 매일 쓰는 서식 파일(엑셀 .xlsx, 한글 .hwpx)을 고릅니다.
                        엑셀은 왼쪽에 열린 서식에서 채울 칸을 클릭해 지정하고, 한글은 서식에 {{날짜}}처럼 자리 글자를 적어 둡니다.
                        저장하면 서식 파일이 프로그램 폴더의 '서식' 폴더로 복사됩니다(원본은 그대로).
                    </TextBlock>
                </DockPanel>

                <DockPanel Style="{StaticResource Row}">
                    <Border Style="{StaticResource Num}"><TextBlock Style="{StaticResource NumText}" Text="2"/></Border>
                    <TextBlock Style="{StaticResource Body}">
                        <Run FontWeight="SemiBold" Text="첫날 누계 입력 (가장 중요)"/><LineBreak/>
                        처음 쓰는 날은 이전에 만든 파일이 없어서 누계를 알 수 없습니다.
                        [장비 · 인원] 단계에서 '전일(대)'와 '전일누계(명)' 칸에 <Run FontWeight="SemiBold" Text="지금까지의 누계"/>를 직접 입력하세요.
                        이 값이 기준이 됩니다. 다음 날부터는 앞선 날짜의 파일에서 '전일 + 금일'을 더해 자동으로 이어집니다
                        (주말·쉬는 날은 건너뛰고 가장 최근 파일을 씁니다).
                    </TextBlock>
                </DockPanel>

                <DockPanel Style="{StaticResource Row}">
                    <Border Style="{StaticResource Num}"><TextBlock Style="{StaticResource NumText}" Text="3"/></Border>
                    <TextBlock Style="{StaticResource Body}">
                        <Run FontWeight="SemiBold" Text="사진 폴더 지정 (사진이 들어가는 문서만)"/><LineBreak/>
                        [사진 · 측정값] 단계에서 [폴더 바꾸기]로 사진이 올라오는 폴더(예: 구글 드라이브)를 한 번 지정합니다.
                        다음부터는 [폴더에서 오늘 사진 불러오기]만 누르면 촬영 시각에 맞춰 칸에 들어갑니다.
                    </TextBlock>
                </DockPanel>

                <!-- ── 매일 ── -->
                <TextBlock Style="{StaticResource H1}" Text="매일 하는 것"/>

                <DockPanel Style="{StaticResource Row}">
                    <Border Style="{StaticResource Num}"><TextBlock Style="{StaticResource NumText}" Text="1"/></Border>
                    <TextBlock Style="{StaticResource Body}">
                        <Run FontWeight="SemiBold" Text="문서 고르기"/><LineBreak/>
                        [문서 · 기본 정보]에서 날짜를 확인하고 오늘 만들 문서를 체크합니다.
                        체크한 문서에 필요한 단계만 왼쪽에 나타납니다. 날짜 옆 ◀ ▶ 로 하루씩, [오늘]로 바로 돌아옵니다.
                        서식 파일이 없거나 저장 이름이 겹치는 문서는 이름 아래에 빨간 글씨로 알려 줍니다.
                    </TextBlock>
                </DockPanel>

                <DockPanel Style="{StaticResource Row}">
                    <Border Style="{StaticResource Num}"><TextBlock Style="{StaticResource NumText}" Text="2"/></Border>
                    <TextBlock Style="{StaticResource Body}">
                        <Run FontWeight="SemiBold" Text="왼쪽 단계 차례로 입력"/><LineBreak/>
                        아래 [다음 ▶]으로 넘어가며 작업사항, 장비 · 인원, 사진 · 측정값을 채웁니다.
                        다 채운 단계는 번호가 초록 ✔로 바뀝니다.
                        장비 · 인원 표는 칸을 한 번 누르면 바로 숫자를 칠 수 있습니다.
                        [↻ 금일 칸을 전일과 같게]를 누르면 앞 날짜의 금일 대수 · 인원이 그대로 들어가니 바뀐 것만 고치세요.
                    </TextBlock>
                </DockPanel>

                <DockPanel Style="{StaticResource Row}">
                    <Border Style="{StaticResource Num}"><TextBlock Style="{StaticResource NumText}" Text="3"/></Border>
                    <TextBlock Style="{StaticResource Body}">
                        <Run FontWeight="SemiBold" Text="[📄 파일 생성]"/><LineBreak/>
                        확인 창에서 빠진 것을 보여 줍니다. 주황(!)은 확인만 하면 되고, 빨강(✖)인 문서는 만들지 않습니다.
                        [생성]을 누르면 파일이 만들어지고 바로 Excel로 열립니다. 결과 창에서 [폴더 열기]도 할 수 있습니다.
                    </TextBlock>
                </DockPanel>

                <!-- ── 알아 둘 것 ── -->
                <TextBlock Style="{StaticResource H1}" Text="알아 둘 것"/>
                <TextBlock Style="{StaticResource Body}">
                    • 같은 날짜로 다시 만들면 앞의 파일을 덮어씁니다. 그 파일이 Excel에 열려 있으면 먼저 닫으세요.
                      덮어쓰기 전의 파일은 output\백업 폴더에 30일 동안 남습니다.<LineBreak/>
                    • 문제가 생기면 프로그램 폴더의 logs 폴더에 기록이 남습니다. 물어볼 때 이 파일을 같이 보여 주세요.<LineBreak/>
                    • 날짜를 바꾸면 그 날짜 기준으로 전일 값을 다시 불러옵니다.<LineBreak/>
                    • 입력하고 파일을 만들지 않은 채 창을 닫으면 한 번 물어봅니다.<LineBreak/>
                    • 한글은 .hwpx만 됩니다. 예전 .hwp는 한글에서 [다른 이름으로 저장 → HWPX]로 바꿔 쓰세요.
                      {{날짜}} 같은 자리 글자는 한 번에 입력하고 중간에 글꼴을 바꾸지 마세요.<LineBreak/>
                    • 회사 · 집 PC에서 같이 쓸 때는 두 PC에서 동시에 켜 두고 설정을 바꾸지 마세요.<LineBreak/>
                    • 이 안내는 오른쪽 위 [❓ 사용법]으로 언제든 다시 볼 수 있습니다.
                </TextBlock>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="#F7FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,10">
            <Button Content="확인" HorizontalAlignment="Right" Width="90" Height="32" IsDefault="True" IsCancel="True"
                    Background="#2B6CB0" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"
                    Click="Close_Click"/>
        </Border>
    </Grid>
</Window>
