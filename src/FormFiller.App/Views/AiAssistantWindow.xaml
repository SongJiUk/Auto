<Window x:Class="FormFiller.App.Views.AiAssistantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🤖 AI 도우미 (Claude)" Height="560" Width="500"
        WindowStartupLocation="CenterOwner"
        FontFamily="Malgun Gothic" FontSize="13"
        ResizeMode="CanResize" MinHeight="400" MinWidth="360">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- API 키 설정 패널 (키 없을 때 표시) -->
        <Border Grid.Row="0" x:Name="ApiKeyPanel"
                Background="#FFFBEB" BorderBrush="#F6E05E"
                BorderThickness="1" CornerRadius="4"
                Padding="10,8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                           Text="Anthropic API 키를 입력하세요. (config.json에 저장됩니다)"
                           Foreground="#744210" FontSize="11" Margin="0,0,0,6"/>
                <TextBox Grid.Row="1" Grid.Column="0"
                         x:Name="ApiKeyBox"
                         Padding="6,4" BorderBrush="#CBD5E0"
                         ToolTip="sk-ant-api03-..."/>
                <Button Grid.Row="1" Grid.Column="1"
                        Content="저장" Margin="6,0,0,0"
                        Padding="10,4" Cursor="Hand"
                        Background="#2B6CB0" Foreground="White" BorderThickness="0"
                        Click="SaveApiKey_Click"/>
            </Grid>
        </Border>

        <!-- 채팅 기록 -->
        <Border Grid.Row="1" BorderBrush="#CBD5E0" BorderThickness="1" CornerRadius="3">
            <ScrollViewer x:Name="ChatScroll"
                          VerticalScrollBarVisibility="Auto"
                          Padding="6">
                <StackPanel x:Name="ChatPanel"/>
            </ScrollViewer>
        </Border>

        <!-- 로딩 표시 -->
        <TextBlock Grid.Row="2" x:Name="LoadingText"
                   Text="⏳ 답변 생성 중..."
                   Foreground="#718096" FontSize="11"
                   Visibility="Collapsed"
                   Margin="0,4,0,0"/>

        <!-- 입력란 -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="InputBox"
                     Grid.Column="0"
                     Padding="8,6"
                     BorderBrush="#CBD5E0"
                     AcceptsReturn="False"
                     ToolTip="질문을 입력하세요... (Enter로 전송)"
                     KeyDown="InputBox_KeyDown"/>
            <Button Grid.Column="1"
                    x:Name="SendButton"
                    Content="전송"
                    Margin="8,0,0,0"
                    Padding="14,6"
                    Background="#2B6CB0" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    Click="Send_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#2B6CB0"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#2C5282"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Background" Value="#A0AEC0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Grid>
</Window>
