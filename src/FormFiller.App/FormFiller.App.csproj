<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- UseWPF: XAML 파일과 WPF 런타임을 사용하겠다는 선언 -->
    <UseWPF>true</UseWPF>

    <RootNamespace>FormFiller.App</RootNamespace>
    <AssemblyName>업무자동화</AssemblyName>

    <!-- 단일 파일 배포 시 WPF 네이티브 DLL(wpfgfx_cor3.dll 등)도 exe 안에 포함한다.
         이게 없으면 exe 옆에 DLL이 따로 생기고, exe만 복사하면 다른 PC에서 실행이 안 된다. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FormFiller.Core\FormFiller.Core.csproj" />
  </ItemGroup>



  <ItemGroup>
    <!-- config.json을 빌드 출력 폴더에 복사한다 (PreserveNewest: 소스가 더 새 것일 때만 복사) -->
    <Content Include="config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
